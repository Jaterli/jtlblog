---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import tasksData from "../data/tasks.json";

// Metadata
const title = "Mis Tareas | Hoja de Ruta & Aprendizaje";
const description = "Lista de tareas personales relacionadas con mi aprendizaje y desarrollo profesional en el ámbito del desarrollo web, IA y blockchain.";

interface Task {
  description: string;
  details?: string;
  startDay: string | null;
  endDay: string | null;
}

const tasks: Task[] = tasksData.tasks;
let visibleTasks = 10;
const totalTasks = tasks.length;

const isTaskPending = (endDay: string | null): boolean => {
  if (!endDay) return true;
  const endDate = new Date(endDay);
  const today = new Date();
  return endDate > today;
};

const formatDateLabel = (startDay: string | null, endDay: string | null): string => {
  if (!startDay) return "Sin iniciar";
  
  const formattedStart = new Date(startDay).toLocaleDateString("es-ES", {
    year: "numeric",
    month: "short",
    day: "numeric"
  });

  if (endDay) {
    const formattedEnd = new Date(endDay).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "short",
      day: "numeric"
    });
    return startDay === endDay
      ? `Finalizado el ${formattedStart}`
      : `Desde el ${formattedStart} hasta el ${formattedEnd}`;
  }

  return `Iniciado el ${formattedStart}`;
};
---

<BaseLayout title={title} description={description} sideBarActiveItemID="tareas">

  {/* HERO HEADER (Sin imagen principal) */}
  <section class="relative overflow-hidden rounded-2xl border-2 border-base-300 bg-base-200/80 p-4 sm:p-10 shadow-md mb-10">
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none bg-[url('/images/others/hero-pattern.svg')] bg-cover bg-center" aria-hidden="true"></div>
    <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/10 text-xs font-semibold text-primary mb-3">
        <Icon name="mdi:format-list-checks" class="w-4 h-4" />
        Hoja de Ruta Personal
      </span>

      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight mb-4 text-base-content">
        Mis <span class="text-primary">Tareas & Objetivos</span>
      </h1>

      <p class="text-lg text-base-content/80 leading-relaxed">
        Esta sección sirve como fuente de motivación personal. Ver el progreso tangible me impulsa a seguir aprendiendo, creando y mejorando, mientras comparto mi viaje de aprendizaje continuo con quienes visitan mi sitio.
      </p>
    </div>
  </section>

  {/* LISTADO DE TAREAS */}
  <section class="mt-8 mb-8">
    <div class="flex items-center justify-between gap-3 mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-primary text-primary-content shadow-xs">
          <Icon name="mdi:checkbox-marked-circle-outline" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Listado de Actividades</h2>
          <p class="text-xs sm:text-sm text-base-content/70">Seguimiento en tiempo real de progresos e hitos</p>
        </div>
      </div>

      <span class="hidden sm:block font-mono text-xs font-semibold px-3 py-1 rounded-full bg-base-200 border border-base-300 text-base-content/80">
        Total: {totalTasks}
      </span>
    </div>

    <ul class="space-y-4" id="tasks-list" data-visible={visibleTasks} data-total={totalTasks}>
      {tasks.slice(0, visibleTasks).map((task) => {
        const pending = isTaskPending(task.endDay);
        return (
          <li class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-5 shadow-sm hover:border-primary/50 transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-2">
              <div class="sm:flex items-start gap-3">
                <div class={`mb-2 sm:mb-0 w-fit p-1.5 rounded-lg shrink-0 mt-0.5 ${pending ? 'bg-warning/10 text-warning border border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20'}`}>
                  <Icon name={pending ? "mdi:clock-outline" : "mdi:check-circle-outline"} class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base sm:text-lg text-base-content leading-snug">
                    {task.description}
                  </h3>
                  {task.details && (
                    <p class="text-xs sm:text-sm text-base-content/80 leading-relaxed mt-1">
                      {task.details}
                    </p>
                  )}
                </div>
              </div>

              <span class={`hidden sm:block font-mono text-xs font-bold px-2.5 py-1 rounded-md shrink-0 border self-start ${pending ? 'bg-warning/10 text-warning border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20'}`}>
                {pending ? 'En Progreso' : 'Completada'}
              </span>
            </div>

            <div class="flex items-center gap-1.5 pt-3 mt-3 border-t border-base-300/80 font-mono text-xs text-base-content/60">
              <Icon name="mdi:calendar-month-outline" class="w-4 h-4 text-primary shrink-0" />
              <span>{formatDateLabel(task.startDay, task.endDay)}</span>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  {/* BOTÓN CARGAR MÁS */}
  {visibleTasks < totalTasks && (
    <div class="text-center mt-8 mb-12">
      <button 
        id="load-more-button"
        class="btn btn-primary rounded-lg px-8 shadow-md inline-flex items-center gap-2"
        aria-label="Cargar más tareas"
      >
        <Icon name="mdi:plus-circle-outline" class="w-5 h-5" />
        <span>Cargar más tareas</span>
      </button>
    </div>
  )}

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const tasksContainer = document.getElementById("tasks-list");
      const loadMoreButton = document.getElementById("load-more-button");

      if (!tasksContainer || !loadMoreButton) return;

      loadMoreButton.addEventListener("click", async () => {
        let visibleTasks = parseInt(tasksContainer.dataset.visible || "10");
        const totalTasks = parseInt(tasksContainer.dataset.total || "0");
        const newVisibleTasks = visibleTasks + 3;

        try {
          const response = await fetch(`/api/getMoreTasks?start=${visibleTasks}&end=${newVisibleTasks}`);
          if (!response.ok) throw new Error("Error al cargar más tareas");

          const data = await response.json();
          data.forEach((task: { description: string; details?: string; startDay: string | null; endDay: string | null }) => {
            const isPending = !task.endDay || new Date(task.endDay) > new Date();
            
            let dateText = "Sin iniciar";
            if (task.startDay) {
              const formattedStart = new Date(task.startDay).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });
              if (task.endDay) {
                const formattedEnd = new Date(task.endDay).toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });
                dateText = task.startDay === task.endDay ? `Finalizado el ${formattedStart}` : `Desde el ${formattedStart} hasta el ${formattedEnd}`;
              } else {
                dateText = `Iniciado el ${formattedStart}`;
              }
            }

            const taskElement = document.createElement("li");
            taskElement.className = "rounded-2xl border-2 border-base-300 bg-base-200/90 p-5 shadow-sm hover:border-primary/50 transition-colors";
            
            taskElement.innerHTML = `
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-2">
                <div class="flex items-start gap-3">
                  <div class="p-1.5 rounded-lg shrink-0 mt-0.5 ${isPending ? 'bg-warning/10 text-warning border border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20'}">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      ${isPending 
                        ? '<path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16zm0-18a10 10 0 1 1 0 20 10 10 0 0 1 0-20zm1 5h-2v6h6v-2h-4V7z"/>' 
                        : '<path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>'}
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-heading font-bold text-base sm:text-lg text-base-content leading-snug">
                      ${task.description}
                    </h3>
                    ${task.details ? `<p class="text-xs sm:text-sm text-base-content/80 leading-relaxed mt-1">${task.details}</p>` : ""}
                  </div>
                </div>
                <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-md shrink-0 border self-start ${isPending ? 'bg-warning/10 text-warning border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20'}">
                  ${isPending ? 'En Progreso' : 'Completada'}
                </span>
              </div>
              <div class="flex items-center gap-1.5 pt-3 mt-3 border-t border-base-300/80 font-mono text-xs text-base-content/60">
                <svg class="w-4 h-4 text-primary shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>
                </svg>
                <span>${dateText}</span>
              </div>
            `;
            tasksContainer.appendChild(taskElement);
          });

          tasksContainer.dataset.visible = newVisibleTasks.toString();
          if (newVisibleTasks >= totalTasks) loadMoreButton.style.display = "none";
        } catch (error) {
          console.error("Error:", error);
          const errorMessage = document.createElement("p");
          errorMessage.className = "text-error text-center mt-4 text-xs font-semibold";
          errorMessage.textContent = "Hubo un error al cargar más tareas. Por favor, inténtalo de nuevo.";
          tasksContainer.appendChild(errorMessage);
        }
      });
    });
  </script>
</BaseLayout>