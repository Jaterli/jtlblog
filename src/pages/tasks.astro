---
import BaseLayout from "../layouts/BaseLayout.astro";
import tasksData from "../data/tasks.json";

interface Task {
  description: string;
  details?: string;
  startDay: string | null; // Permitir null para tareas pendientes
  endDay: string | null;
}

const tasks: Task[] = tasksData.tasks;
let visibleTasks = 10;
const totalTasks = tasks.length;

const isTaskPending = (endDay: string | null): boolean => {
  if (!endDay) return true;
  const endDate = new Date(endDay);
  const today = new Date();
  return endDate > today;
};
---

<BaseLayout title="Mis tareas" sideBarActiveItemID="tareas">
  <article class="max-w-3xl mx-auto prose prose-lg">
    <h1 class="text-4xl text-center">Mis tareas</h1>
    <p class="text-center">
      Esta sección sirve como fuente de motivación personal. Ver el progreso tangible me impulsa a seguir aprendiendo, creando y mejorando, mientras comparto mi viaje con quienes visitan mi sitio.
    </p>
    <hr />
  </article>

  <section class="mt-10 mb-6">
    <h2 class="text-2xl mb-4">Tareas</h2>
    <ul class="space-y-4" id="tasks-list" data-visible={visibleTasks} data-total={totalTasks}>
      {tasks.slice(0, visibleTasks).map((task) => {
        const isPending = isTaskPending(task.endDay);
        return (
          <li class="p-4 bg-base-200">
            <div class="flex items-center gap-2">
              {isPending ? (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 min-w-[25px] text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 min-w-[25px] text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              )}
              <p class={`text-xl ${isPending ? 'text-red-600' : 'text-green-600'}`}>
                {task.description}
              </p>
            </div>
            {task.details && <p class="mt-2 italic opacity-85">{task.details}</p>}
            <p class="text-sm mt-2 opacity-75">
              {task.startDay
                ? task.endDay
                  ? task.startDay === task.endDay
                    ? `Completado el ${new Date(task.startDay).toLocaleDateString("es-ES")}`
                    : `Desde el ${new Date(task.startDay).toLocaleDateString("es-ES")} hasta el ${new Date(task.endDay).toLocaleDateString("es-ES")}`
                  : `Iniciado el ${new Date(task.startDay).toLocaleDateString("es-ES")}`
                : "Sin iniciar"}
            </p>
          </li>
        );
      })}
    </ul>
  </section>

  {visibleTasks < totalTasks && (
    <div class="text-center">
      <button 
        id="load-more-button"
        class="mt-4 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition-colors"
        aria-label="Cargar más tareas"
      >
        Ver más
      </button>
    </div>
  )}

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const tasksContainer = document.getElementById("tasks-list");
      const loadMoreButton = document.getElementById("load-more-button");
      console.log("DOM cargado");

      if (!tasksContainer || !loadMoreButton) return;

      loadMoreButton.addEventListener("click", async () => {
        let visibleTasks = parseInt(tasksContainer.dataset.visible || "10");
        const totalTasks = parseInt(tasksContainer.dataset.total || "0");
        const newVisibleTasks = visibleTasks + 3;

        try {
          const response = await fetch(`/api/getMoreTasks?start=${visibleTasks}&end=${newVisibleTasks}`);
          if (!response.ok) throw new Error("Error al cargar más tareas");

          const data = await response.json();
          data.forEach((task) => {
            const isPending = !task.endDay || new Date(task.endDay) > new Date();
            const taskElement = document.createElement("li");
            taskElement.className = "p-4 bg-base-200";
            taskElement.innerHTML = `
              <div class="flex items-center gap-2">
                ${
                  isPending
                    ? `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 min-w-[25px] text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 min-w-[25px] text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>`
                }
                <p class="text-xl ${isPending ? 'text-red-600' : 'text-green-600'}">${task.description}</p>
              </div>
              ${task.details ? `<p class="mt-2 italic opacity-85">${task.details}</p>` : ""}
              <p class="text-sm mt-2 opacity-75">
                ${
                  task.startDay
                  ? task.endDay
                    ? task.startDay === task.endDay
                      ? `Completado el ${new Date(task.startDay).toLocaleDateString()}`
                      : `Desde el ${new Date(task.startDay).toLocaleDateString()} hasta el ${new Date(task.endDay).toLocaleDateString()}`
                    : `Iniciado el ${new Date(task.startDay).toLocaleDateString()}`
                  : "Sin iniciar"
                }
              </p>
            `;
            tasksContainer.appendChild(taskElement);
          });

          tasksContainer.dataset.visible = newVisibleTasks.toString();
          if (newVisibleTasks >= totalTasks) loadMoreButton.style.display = "none";
        } catch (error) {
          console.error("Error:", error);
          // Mostrar un mensaje de error en la interfaz
          const errorMessage = document.createElement("p");
          errorMessage.className = "text-red-600 text-center mt-4";
          errorMessage.textContent = "Hubo un error al cargar más tareas. Por favor, inténtalo de nuevo.";
          tasksContainer.appendChild(errorMessage);
        }
      });
    });
  </script>
</BaseLayout>