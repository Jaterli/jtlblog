---
import { type CollectionEntry, getCollection, render } from "astro:content";
import JobItemLayout from "@layouts/JobLayout.astro";
import generateSlug from "src/lib/generateUrlSlug";

export async function getStaticPaths() {
  const itemEntries = await getCollection("jobs");
  return itemEntries.map((entry) => ({
    params: { slug: generateSlug(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"jobs">;
}

const { entry } = Astro.props;
const item = entry.data;
const { Content } = await render(entry);
---

<JobItemLayout
  title={item.title}
  description={item.description}
  heroImage={item.heroImage}
  startDate={item.startDate}
  endDate={item.endDate}
  pubDate={item.pubDate}
  badge={item.badge}
>
  <Content />
</JobItemLayout>
