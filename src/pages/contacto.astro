---
import BaseLayout from "@layouts/BaseLayout.astro";
import Contactform from "@components/Contactform.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout sideBarActiveItemID="contacto">

  <article class="max-w-3xl mx-auto prose prose-lg">
    <h1 class="text-center text-4xl mb-6">Contacto</h1>
      <div>
        <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl sm:mt-16">
          <div>            
            <p class="mt-0">
              Puedes preguntarme cualquier cosa relacionada con mi blog, mis conocimientos, servicios o notificarme de errores o posibles mejoras,
              estaré encantado de responderrte.
            </p>
            <div class="mt-5">
            <img src="/images/others/datos-contacto.png" class="m-0" />
              <!-- <div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:map-marker" /><span>Madrid, España</span>
              </div>
              <div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:envelope" /><span>admin@jaterli.com</span> 
              </div>
              <div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:phone" /><span>+34 659 602 588</span>                 
              </div> -->

            </div>
          </div>
          <div>
            <Contactform />
          </div>
        </div>
      </div>

    </article>
</BaseLayout>
---
<script lang="ts">
// Seleccionar todos los elementos que tengan el atributo data-nosearch
const elements = document.querySelectorAll('[data-nosearch]');

elements.forEach((element) => {
    const replacementText = element.getAttribute('data-nosearch');
    
    if (replacementText) {
        element.textContent = replacementText;
    }
});
</script>