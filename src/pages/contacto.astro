---
import BaseLayout from "../layouts/BaseLayout.astro";
import Contactform from "../components/Contactform.astro";
import { Icon } from "astro-icon/components";

const title = "Contacto | Jaime TL - Desarrollador Full Stack, IA & Blockchain";
const description =
  "¿Tienes una idea, consulta o propuesta de colaboración? Ponte en contacto conmigo a través del formulario, correo electrónico o WhatsApp.";
const image = "/images/others/profile-photo.webp";

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/jaterli",
    icon: "mdi:linkedin",
  },
  {
    label: "GitHub",
    href: "https://github.com/Jaterli",
    icon: "mdi:github",
  },
  {
    label: "Telegram",
    href: "https://t.me/jaterli",
    icon: "mdi:telegram",
  },
  {
    label: "Discord",
    href: "https://discord.com/users/1042392132910055464",
    icon: "mdi:discord",
  }
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  sideBarActiveItemID="contacto"
>
  <!-- ============================================================
      CABECERA / HERO DE CONTACTO
  ============================================================ -->
  <section
    class="relative overflow-hidden rounded-2xl border-2 border-base-300 bg-base-200/80 px-4 sm:px-10 py-12 sm:py-16 shadow-md"
  >
    <div
      class="absolute inset-0 opacity-[0.04] pointer-events-none bg-[url('/images/others/hero-pattern.svg')] bg-cover bg-center"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative flex flex-col md:flex-row items-center gap-8 lg:gap-12">
      <!-- Texto Principal (Izquierda) -->
      <div class="text-center md:text-left flex-1">
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/10 text-xs font-semibold text-primary mb-3"
        >
          <Icon name="mdi:send-outline" class="w-4 h-4" />
          ¿Hablamos?
        </span>

        <h1
          class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.15] mb-4 text-base-content"
        >
          Ponte en <span class="text-primary">Contacto</span>
        </h1>

        <p class="text-base sm:text-lg text-base-content/80 leading-relaxed mb-6">
          Tanto si buscas impulsar tu proyecto con soluciones de <strong>desarrollo web</strong>, <strong>Inteligencia Artificial</strong>, <strong>Blockchain</strong>, <strong>ciberseguridad</strong>, <strong>SEO</strong> o <strong>consultoría técnica</strong>, como si deseas realizar una consulta sobre mis proyectos, intercambiar ideas o explorar colaboraciones profesionales, estaré encantado de responderte.
        </p>

        <div class="flex flex-wrap gap-3 justify-center md:justify-start">
          <a
            href="https://wa.me/34659602588"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary rounded-lg px-6 shadow-sm hover:shadow-md transition-all inline-flex items-center gap-2"
          >
            <Icon name="mdi:whatsapp" class="w-5 h-5" />
            Escribir por WhatsApp
          </a>
          <a
            href="mailto:admin@jaterli.com"
            class="btn btn-outline rounded-lg bg-base-100 hover:bg-base-200 border-base-300 transition-colors inline-flex items-center gap-2"
          >
            <Icon name="mdi:email-outline" class="w-5 h-5 text-primary" />
            Enviar Email
          </a>
        </div>
      </div>

      <!-- Imagen Representativa (Derecha) -->
      <div class="relative shrink-0 w-full max-w-xs md:max-w-sm lg:max-w-md">
        <div class="relative rounded-2xl overflow-hidden border-2 border-base-300 bg-base-100 p-2 shadow-lg">
          <img
            src="/images/others/hero-contact.webp"
            alt="Ilustración de Contacto y Comunicación Digital"
            class="w-full h-auto rounded-xl object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CANALES DE CONTACTO Y FORMULARIO
  ============================================================ -->
  <section class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Columna Izquierda (5 Columnas) -->
    <div class="lg:col-span-5 space-y-6">
      <!-- Tarjeta de Redes Sociales (2 Columnas) -->
      <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 shadow-sm">
        <h2 class="font-heading text-2xl font-bold text-base-content mb-2">
          Redes Sociales
        </h2>
        <p class="text-sm text-base-content/70 mb-6">
          Encuéntrame y sígueme en mis perfiles de redes sociales.
        </p>

        <div class="grid grid-cols-2 gap-3">
          {
            socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 p-3.5 rounded-xl bg-base-100 border border-base-300 hover:border-primary/50 text-base-content hover:text-primary transition-colors"
              >
                <div class="p-2 rounded-lg bg-primary/10 text-primary shrink-0">
                  <Icon name={social.icon} class="w-5 h-5" />
                </div>
                <span class="text-sm font-bold truncate">{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Tarjeta adicional de Disponibilidad -->
      <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-6 shadow-sm">
        <div class="flex items-center gap-3 mb-3">
          <div class="p-2 rounded-lg bg-primary text-primary-content">
            <Icon name="mdi:clock-check-outline" class="w-5 h-5" />
          </div>
          <h3 class="font-heading font-bold text-base text-base-content">
            Atención & Disponibilidad
          </h3>
        </div>
        <p class="text-sm text-base-content/80 leading-relaxed">
          Suelo responder a los mensajes en menos de <strong>24 horas laborales</strong>. Para consultas urgentes o conversaciones rápidas, te recomiendo escribir directamente por WhatsApp.
        </p>
      </div>
    </div>

    <!-- Columna Derecha (7 Columnas) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Formulario de Contacto -->
      <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 shadow-sm">
        <div class="mb-6">
          <h2 class="font-heading text-2xl font-bold text-base-content">
            Envia un Mensaje
          </h2>
          <p class="text-sm text-base-content/70 mt-1">
            Rellena el formulario a continuación y me pondré en contacto contigo a la brevedad.
          </p>
        </div>

        <Contactform />
      </div>

      <!-- Layout de Ubicación -->
      <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 shadow-sm">
        <div class="flex items-center gap-3 mb-4">
          <div class="p-2.5 rounded-lg bg-primary/10 text-primary shrink-0">
            <Icon name="mdi:map-marker-outline" class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-heading text-2xl font-bold text-base-content">
              Ubicación
            </h2>
            <p class="text-sm text-base-content/70">
              Madrid, España
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>