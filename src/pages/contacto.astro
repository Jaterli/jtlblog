---
import BaseLayout from "@layouts/BaseLayout.astro";

//import Contactform from "@components/Contactform.astro";
import { Icon } from "astro-icon/components";

import Button from "@components/ui/Button.astro";
import { defineMiddleware } from "astro:middleware";

export const onRequest = defineMiddleware(async (context, next) => {
  const response = await next(); // Llamamos a la siguiente función en la cadena de middleware
  response.headers.set("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  return response;
});


---

<BaseLayout sideBarActiveItemID="contacto">
  <div class="pb-12 mt-5">
    <div class="text-5xl font-bold">Contacto</div>
    <div class="py-2">
      <text class="text-lg">

        <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
          <div>            
            <p class="text-lg leading-relaxed mt-3">
              Puedes preguntarme cualquier cosa relacionada con mi blog o con mis conocimientos personales,
              estaré encantado de responderrte.
            </p>
            <div class="mt-5">
              <div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:map-marker" />
                <span>&nbsp;Madrid, España</span>
              </div><div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:envelope" /><a href="mailto:jaime.terciado@gmail.com"
                  >&nbsp;jaime.terciado@gmail.com</a>
              </div><div class="flex items-center mt-2 space-x-2">
                <Icon class="w-4 h-4" name="uil:phone" /><a
                  href="tel:+34 (---) -- -- --">&nbsp;+34 --- -- -- --</a>
              </div>
            </div>
          </div>
          <div>
            
            
            <form
            method="post"
            class="needs-validation"
            name="contact" 
            id="contact-form"
            action="/"
            data-netlify-recaptcha="true"
            data-netlify="true"
          >
            
            <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
            <div class="mb-5">
              <input
                type="text"
                placeholder="Nombre completo"
                required
                class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
                name="name"
              />
            </div>
            <div class="mb-5">
              <label for="email_address" class="sr-only">Correo electrónico</label>
              <input
                id="email_address"
                type="email"
                placeholder="Correo electrónico"
                name="email"
                required
                class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
              />
            </div>
            <div class="mb-3">
              <textarea
                name="message"
                required
                placeholder="Tu mensaje"
                class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
              ></textarea>
            </div>
          
            <div class="d-flex justify-content-center mb-2">
              <div id="recaptcha-container" data-netlify-recaptcha="true"></div>
            </div>
            <Button type="submit" size="lg" block>Enviar mensaje</Button>
          </form>
          
          <div id="contact-form-result" class="d-flex align-items-center justify-content-center" style="min-height: 100px;"></div>
          
          
          <script src="/js/contact-form.js" defer></script>
          



          </div>
        </div>
    
      </text>
    </div>
  
  </div>
</BaseLayout>
