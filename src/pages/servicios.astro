---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Servicios Profesionales de Desarrollo Web, Web3 y SEO Técnico";
const description = "Transformo tus ideas en soluciones digitales potentes, seguras y escalables. Desde plataformas web hasta aplicaciones blockchain y optimización SEO.";
const image="/images/others/Logo-jtl-domain.png";
---

<BaseLayout title={title} description={description} image={image} ogType="article" sideBarActiveItemID="servicios">
  <article class="prose prose-lg">
    <h1 class="text-center mb-6">Servicios Profesionales de Desarrollo Web, Web3 y SEO</h1>

    <div class="text-center mb-8">
      Transformo tus ideas en soluciones digitales potentes, seguras y escalables. Desde plataformas web hasta aplicaciones blockchain y optimización SEO, te acompaño en cada fase del desarrollo, integrando buenas prácticas de arquitectura, seguridad, experiencia de usuario y visibilidad en buscadores.
    </div>

    <hr class="my-6" />

    <section class="space-y-6">
      <details class="p-4 bg-base-200 rounded-xl shadow-sm" open>
        <summary class="text-xl font-semibold cursor-pointer">Desarrollo Backend, APIs Seguras y Go</summary>
        <ul class="mt-3 list-disc">
          <li><strong>Aplicaciones robustas con Go y Django</strong> – Backend completo con arquitectura escalable, manejo eficiente de datos, y servicios de alto rendimiento.</li>
          <li><strong>APIs REST y GraphQL seguras</strong> – Autenticación con JWT en cookies HttpOnly, permisos granulares, y protección contra ataques comunes (SQLi, XSS, CSRF).</li>
          <li><strong>Integración con Inteligencia Artificial</strong> – Conexión a APIs de IA para generación de contenido, análisis de datos y automatización de procesos dentro de la aplicación.</li>
          <li><strong>Integración Web3 y autenticación moderna</strong> – Soporte para MetaMask, WalletConnect y validación de firma digital, garantizando accesos seguros y controlados.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">Desarrollo Frontend Seguro y Escalable</summary>
        <ul class="mt-3 list-disc ml-5">
          <li><strong>Interfaces modernas con Angular y React</strong> – Desarrollo con TypeScript, gestión de estado reactiva y componentes reutilizables; diseño adaptable (responsive) y enfoque en accesibilidad y seguridad en el cliente.</li>
          <li><strong>Frameworks y librerías de estilos</strong> – Uso de <strong>TailwindCSS</strong>, <strong>Bootstrap</strong> y <strong>Chakra UI</strong> para interfaces limpias, consistentes y altamente personalizables.</li>
          <li><strong>Aplicaciones estáticas y rápidas</strong> – Generación de sitios con Astro o Angular Universal, optimizados para rendimiento y seguridad, fácilmente integrables con APIs y CMS.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">Blockchain y Contratos Inteligentes</summary>
        <ul class="mt-3 list-disc">
          <li><strong>Desarrollo de smart contracts seguros</strong> – Contratos en Solidity con patrones recomendados y pruebas rigurosas (tests y simulaciones).</li>
          <li><strong>Marketplaces Web3 y pagos confiables</strong> – Diseño de plataformas descentralizadas con gestión de pagos, escrow y validación en cadena.</li>
          <li><strong>Autenticación descentralizada</strong> – Implementación del estándar EIP-4361 ("Sign-In with Ethereum") para login seguro sin contraseñas.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">Seguridad Aplicada en Todo el Ciclo</summary>
        <ul class="mt-3 list-disc">
          <li><strong>JWT y sesiones seguras</strong> – Tokens rotativos, control de revocación, sesiones persistentes sin comprometer la seguridad.</li>
          <li><strong>Anti-fraude en Web3</strong> – Validación de eventos on-chain, detección de actividad sospechosa y alertas.</li>
          <li><strong>Auditoría técnica de DApps</strong> – Análisis de vulnerabilidades en frontend, contratos y arquitectura general.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">SEO Técnico y Estrategias de Posicionamiento</summary>
        <ul class="mt-3 list-disc">
          <li><strong>SEO Técnico</strong> – Optimización de velocidad de carga, arquitectura limpia, indexación eficiente y configuración de metadatos.</li>
          <li><strong>SEO On-Page</strong> – Contenido optimizado con palabras clave estratégicas, jerarquía de encabezados clara y datos estructurados con JSON-LD.</li>
          <li><strong>SEO proyectos innovadores</strong> – Adaptación de estrategias de posicionamiento para plataformas digitales, aplicaciones emergentes y tecnologías en crecimiento.</li>
          <li><strong>Analítica y seguimiento</strong> – Integración con Google Search Console, Analytics y dashboards personalizados.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">Despliegue y Gestión en Producción</summary>
        <ul class="mt-3 list-disc">
          <li><strong>Entornos Dockerizados</strong> – Configuración eficiente, segura y fácil de replicar en servidores locales o cloud.</li>
          <li><strong>Seguridad en producción</strong> – WAF, HTTPS, headers seguros, rate limiting y detección de amenazas.</li>
          <li><strong>CI/CD y monitoreo</strong> – Integración continua, despliegue automatizado y seguimiento del rendimiento.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">WordPress Profesional para Empresas</summary>
        <ul class="mt-3 list-disc">
          <li><strong>Diseño moderno y adaptable</strong> – Sitios rápidos, visualmente atractivos y optimizados para móvil y escritorio.</li>
          <li><strong>SEO y rendimiento</strong> – Carga optimizada, arquitectura limpia y seguimiento mediante herramientas como Google Search Console.</li>
          <li><strong>Seguridad reforzada</strong> – Plugins seleccionados, backups automáticos y protección contra malware y spam.</li>
          <li><strong>Formularios RGPD y multilingüe</strong> – Conformidad legal, accesibilidad y posibilidad de sitio multilingüe.</li>
          <li><strong>Blog profesional y mantenimiento</strong> – Espacio editorial gestionable y soporte técnico opcional.</li>
        </ul>
      </details>

      <details class="p-4 bg-base-200 rounded-xl shadow-sm">
        <summary class="text-xl font-semibold cursor-pointer">Consultoría Técnica y Formación</summary>
        <ul class="mt-3 list-disc">
          <li><strong>Mentoría para equipos de desarrollo</strong> – Asesoría en buenas prácticas de arquitectura, testing, seguridad y patrones de diseño.</li>
          <li><strong>Formación técnica</strong> – Sesiones personalizadas sobre Django, React, Web3, seguridad, despliegue, SEO y más.</li>
          <li><strong>Auditoría de código</strong> – Revisión detallada de código base y sugerencias para mejorar escalabilidad y seguridad.</li>
        </ul>
      </details>
    </section>
  </article>

  <!-- JSON-LD para SEO local de servicios -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Desarrollo Web, Web3 y SEO Técnico",
    "provider": {
      "@type": "Person",
      "name": "Jaime TL",
      "url": "https://tusitio.com"
    },
    "description": "Servicios profesionales de desarrollo web con Django, React, blockchain y optimización SEO.",
    "areaServed": "España",
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceUrl": "https://tusitio.com/servicios"
    }
  }
  </script>
</BaseLayout>
