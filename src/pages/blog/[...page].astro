---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getPostUrl } from "@lib/getPostUrl";
import { pageUrl, getPageNumbers } from "@lib/pagination";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = await getCollection("blog");
  posts.sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 9 });
}

interface Props {
  page: {
    data: any[];
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
      current: string;
      prev: string | undefined;
      next: string | undefined;
    };
  };
}

const { page } = Astro.props;
const title = "Blog de Desarrollo Web, IA y Blockchain";
const description =
  "Experiencias en desarrollo web full stack, agentes de IA, blockchain, tutoriales prácticos, certificaciones y reflexiones sobre tecnología.";
const image = "/images/others/profile-photo.webp";

const currentPath = page.url.current.replace(/\/$/, "") || "/";
const basePath = currentPath.replace(/\/\d+$/, "") || "/";

const pageNumbers =
  page.lastPage > 1 ? getPageNumbers(page.currentPage, page.lastPage) : [];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  sideBarActiveItemID="blog"
>
  <!-- ============================================================
      CABECERA / HERO REVISADO
  ============================================================ -->
  <section
    class="relative overflow-hidden rounded-2xl border border-base-300/60 bg-gradient-to-br from-base-100 via-base-200 to-base-100 px-4 sm:px-10 py-12 sm:py-14"
  >
    <!-- Fondo decorativo con patrón y brillo -->
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[url('/images/others/hero-pattern.svg')] bg-cover bg-center"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative flex flex-col md:flex-row items-center justify-between md:gap-12">
      <!-- Columna Izquierda: Texto, Botones y Temáticas principales -->
      <div class="w-full md:basis-7/12 md:shrink-0 text-center md:text-left">
        <span
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-base-300 bg-base-100 text-xs font-medium tracking-wide text-base-content/70 backdrop-blur mb-4"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Artículos, Guías & Reflexiones
        </span>

        <h1
          class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.15] mb-4"
        >
          Blog de <span class="text-primary">Desarrollo Web, IA y Blockchain</span>
        </h1>

        <p class="text-base sm:text-lg text-base-content/70 leading-relaxed mb-6">
          Espacio donde comparto experiencias en <strong class="text-base-content">Desarrollo Full Stack</strong>,
          integración de <strong class="text-base-content">Agentes de Inteligencia Artificial</strong>,
          soluciones en <strong class="text-base-content">Web3 & Blockchain</strong>, certificaciones técnicas,
          tutoriales y reflexiones sobre la comunicación y las <strong class="text-base-content">Soft Skills</strong>.
        </p>

        <!-- Botones de Acción (CTA) -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start mb-6">
          <a
            href="#blog-posts"
            class="btn btn-primary rounded-lg px-6 shadow-sm hover:shadow-md transition-shadow"
          >
            <Icon name="mdi:folder-outline" class="w-5 h-5" />
            Ver Posts
          </a>
          <a
            href="/contacto/"
            class="btn btn-outline rounded-lg px-6 hover:bg-base-200 transition-colors"
          >
            <Icon name="mdi:email-outline" class="w-5 h-5" />
            Contactar
          </a>
        </div>

        <!-- Chips con Temáticas Clave -->
        <div class="pt-4 border-t border-base-300/40">
          <p class="text-xs uppercase tracking-[0.15em] text-base-content/50 mb-3">
            Categorías & Temas destacados
          </p>
          <ul class="flex flex-wrap gap-2 justify-center md:justify-start">
            {
              [
                "Desarrollo Full Stack",
                "Agentes de IA (MCP)",
                "Django & React",
                "Web3 & Smart Contracts",
                "Certificaciones",
                "Soft Skills & Comunicación",
                "Scrum & Agilidad",
                "SQL & Base de Datos"
              ].map((topic) => (
                <li class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-100/70 border border-base-300/60 text-base-content/80 hover:text-base-content hover:border-primary/40 transition-colors">
                  {topic}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Columna Derecha: Abanico diagonal alineado a la derecha -->
      <div
        class="hidden md:block relative w-56 h-80 lg:w-64 lg:h-[22rem] flex-shrink-0 md:ml-auto mr-4 lg:mr-8"
        aria-hidden="true"
      >
        <!-- Arriba-izquierda -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-lg hover:scale-105 transition-transform"
          style="transform: translateY(-60%) translate(-25%, -40%) rotate(-12deg); z-index: 1;"
        >
          <img
            src="/images/blog/blog.translator-management-v2.png"
            alt="Translator Management V2"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <!-- Centro (al frente) -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-xl hover:scale-105 transition-transform"
          style="transform: translateY(-50%) translate(-5%, -5%) rotate(-2deg) scale(1.05); z-index: 3;"
        >
          <img
            src="/images/blog/blog.video-angotest.webp"
            alt="Grabación de video AngoTest"
            class="w-full h-full object-cover"
            loading="lazy"
          />        
        </div>

        <!-- Abajo-derecha -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-lg hover:scale-105 transition-transform"
          style="transform: translateY(-50%) translate(10%, 55%) rotate(10deg); z-index: 2;"
        >
          <img
            src="/images/blog/blog.easycryptobuy_v2.webp"
            alt="EasyCryptoBuy Mejoras"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTADOR DE RESULTADOS REVISADO
  ============================================================ -->
  {
    page.total > 0 && (
      <div class="pt-[6rem] mt-[-3rem] flex items-center justify-between text-sm text-base-content/60" id="blog-posts">
        <p>
          Mostrando del <strong class="text-base-content">{page.start + 1}</strong> al{" "}
          <strong class="text-base-content">{page.end + 1}</strong> de{" "}
          <strong class="text-base-content">{page.total}</strong> publicaciones
        </p>
        <p>
          Página <strong class="text-base-content">{page.currentPage}</strong> de{" "}
          <strong class="text-base-content">{page.lastPage}</strong>
        </p>
      </div>
    )
  }

  <!-- ============================================================
       GRID DE ARTÍCULOS
  ============================================================ -->
  {
    page.data.length === 0 ? (
      <div class="mt-8 rounded-xl border border-base-300/60 bg-base-200/40 p-8 text-center">
        <Icon
          name="carbon:document"
          class="w-10 h-10 mx-auto mb-3 text-base-content/30"
        />
        <h2 class="font-heading text-xl font-semibold mb-1">
          Sin publicaciones disponibles
        </h2>
        <p class="text-base text-base-content/60">
          Vuelve pronto: estoy preparando y redactando nuevos artículos.
        </p>
      </div>
    ) : (
      <section class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6" id="blog-posts">
        {page.data.map((post) => (
          <HorizontalCard
            title={post.data.title}
            heroImage={post.data.heroImage}
            description={post.data.description}
            badge={post.data.badge}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            url={getPostUrl(post.id)}
            target="_self"
          />
        ))}
      </section>
    )
  }

  <!-- ============================================================
      PAGINACIÓN NUMÉRICA (MÁXIMO 3 BOTONES + RETROCEDER/AVANZAR)
  ============================================================ -->
  {
    page.lastPage > 1 && (
      <nav
        class="mt-12 pt-8 border-t border-base-300/60 flex justify-center"
        aria-label="Paginación del blog"
      >
        <ul class="flex items-center gap-2 flex-wrap justify-center">
          {/* Botón Retroceder (Anterior) */}
          <li>
            {page.url.prev ? (
              <a
                href={page.url.prev+"#blog-posts"}
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                aria-label="Página anterior"
              >
                <Icon name="mdi:chevron-left" class="w-5 h-5" />
              </a>
            ) : (
              <span
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/40 bg-base-200/20 text-base-content/30 cursor-not-allowed"
                aria-hidden="true"
              >
                <Icon name="mdi:chevron-left" class="w-5 h-5" />
              </span>
            )}
          </li>

          {/* Máximo 3 Números de Página */}
          {pageNumbers.map((n) =>
            n === page.currentPage ? (
              <li>
                <span
                  class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-primary bg-primary text-primary-content text-sm font-semibold shadow-sm"
                  aria-current="page"
                >
                  {n}
                </span>
              </li>
            ) : (
              <li>
                <a
                   href={pageUrl(n, basePath)+"#blog-posts"}
                  class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-sm font-medium text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                >
                  {n}
                </a>
              </li>
            )
          )}

          {/* Botón Avanzar (Siguiente) */}
          <li>
            {page.url.next ? (
              <a
                href={page.url.next+"#blog-posts"}
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                aria-label="Página siguiente"
              >
                <Icon name="mdi:chevron-right" class="w-5 h-5" />
              </a>
            ) : (
              <span
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/40 bg-base-200/20 text-base-content/30 cursor-not-allowed"
                aria-hidden="true"
              >
                <Icon name="mdi:chevron-right" class="w-5 h-5" />
              </span>
            )}
          </li>
        </ul>
      </nav>
    )
  }
</BaseLayout>