---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { getPostUrl } from "@lib/getPostUrl";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const all_posts = await getCollection("blog");

  // Paso 1: Extraer todos los tags y normalizarlos a minúsculas
  const all_tags = [
    ...new Set(
      all_posts.flatMap((post: any) => 
        (post.data.tags || []).map((tag: string) => tag.toLowerCase()) // Convertir cada tag a minúsculas
      )
    )
  ];

  // Paso 2: Generar las rutas paginadas
  return all_tags.flatMap((tag) => {
    const filtred_posts = all_posts
      .filter((post: any) => 
        (post.data.tags || [])
          .map((postTag: string) => postTag.toLowerCase()) // Normalizar tags del post a minúsculas
          .includes(tag) // Comparar con el tag en minúsculas
      )
      .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filtred_posts, {
      params: { tag },
      pageSize: 9,
    });
  });
}

interface Props {
  page: {
    data: any[];
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
      current: string;
      prev: string | undefined;
      next: string | undefined;
    };
  };
}

const { page } = Astro.props;
const params = Astro.params as { tag: string };
---

<BaseLayout title={"Blog - " + params.tag} sideBarActiveItemID="blog">

  <article class="prose prose-lg">

    <h1>Blog de Desarrollo Web y Blockchain</h1>
    <h2 class="mt-0">Etiqueta: {params.tag.toUpperCase()}</h2>
    <p>En este blog comparto mis experiencias en desarrollo web y blockchain, junto con tutoriales prácticos y soluciones técnicas pensadas para programadores que buscan aprender, mejorar sus proyectos y mantenerse al día con las últimas tecnologías.</p>
  </article>
  
  <div class="my-8">Pág(s). {page.currentPage} de {page.lastPage} (Mostrando {page.data.length} de {page.total} posts)</div>
  
  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Lo siento!</p>
        <p>Todavía no se han publicado proyectos.</p>
      </div>
    ) : (
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {page.data.map((post: any) => (
          <HorizontalCard
            title={post.data.title}
            heroImage={post.data.heroImage}
            description={post.data.description}
            badge={post.data.badge}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            url={getPostUrl(post.id)} 
            target="_self"
          />
        ))}
      </section>
    )
  }
  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          Posts más recientes
        </a>
      ) : <div /> 
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Posts más antiguos
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : <div />
    }
  </div>
</BaseLayout>