---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getProjectUrl } from "@lib/getProjectUrl";
import { pageUrl, getPageNumbers } from "@lib/pagination";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const all_entries = await getCollection("projects");

  // Paso 1: Extraer todos los tags y normalizarlos a minúsculas
  const all_tags = [
    ...new Set(
      all_entries.flatMap((entry: any) =>
        (entry.data.tags || []).map((tag: string) => tag.toLowerCase())
      )
    ),
  ];

  // Paso 2: Generar las rutas paginadas
  return all_tags.flatMap((tag) => {
    const filtred_entries = all_entries
      .filter((entry: any) =>
        (entry.data.tags || [])
          .map((entryTag: string) => entryTag.toLowerCase())
          .includes(tag)
      )
      .sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filtred_entries, {
      params: { tag },
      pageSize: 9,
    });
  });
}

interface Props {
  page: {
    data: any[];
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
      current: string;
      prev: string | undefined;
      next: string | undefined;
    };
  };
}

const { page } = Astro.props;
const params = Astro.params;
const tag = params.tag ? params.tag.toUpperCase() : "";

const title = `Proyectos: ${tag}`;
const description = `Portfolio de proyectos de programación filtrados por la etiqueta ${tag}. Explora las soluciones y aplicaciones desarrolladas.`;
const image = "/images/others/profile-photo.webp";

const currentPath = page.url.current.replace(/\/$/, "") || "/";
const basePath = currentPath.replace(/\/\d+$/, "") || "/";

const pageNumbers =
  page.lastPage > 1 ? getPageNumbers(page.currentPage, page.lastPage) : [];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  sideBarActiveItemID="proyectos"
>
  <!-- ============================================================
        CABECERA / HERO FILTRADO POR ETIQUETA
  ============================================================ -->
  <section
    class="relative overflow-hidden rounded-2xl border border-base-300/60 bg-gradient-to-br from-base-100 via-base-200 to-base-100 px-6 sm:px-10 py-12 sm:py-14"
  >
    <!-- Fondo decorativo con patrón y brillo -->
    <div
      class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[url('/images/others/hero-pattern.svg')] bg-cover bg-center"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative flex flex-col md:flex-row items-center justify-between md:gap-12">
      <!-- Columna Izquierda: Texto, Botones e Información de Etiqueta -->
      <div class="w-full md:basis-7/12 md:shrink-0 text-center md:text-left">
        <span
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-base-300/70 bg-base-100/60 text-xs font-medium tracking-wide text-base-content/70 backdrop-blur mb-4"
        >
          <Icon name="mdi:tag-outline" class="w-3.5 h-3.5 text-primary" />
          Filtrado por etiqueta
        </span>

        <h1
          class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.15] mb-4"
        >
          Proyectos sobre <span class="text-primary">{tag}</span>
        </h1>

        <p class="text-base sm:text-lg text-base-content/70 leading-relaxed mb-6">
          Selección de trabajos, aplicaciones y desarrollos clasificados bajo la etiqueta <strong class="text-base-content">#{tag}</strong>. Descubre la arquitectura, código y tecnología detrás de cada uno.
        </p>

        <!-- Botones de Acción (CTA) -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start mb-6">
          <a
            href="/proyectos"
            class="btn btn-primary rounded-lg px-6 shadow-sm hover:shadow-md transition-shadow"
          >
            <Icon name="mdi:folder-outline" class="w-5 h-5" />
            Ver Todos los Proyectos
          </a>
          <a
            href="https://github.com/Jaterli"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline rounded-lg px-6 hover:bg-base-200 transition-colors"
          >
            <Icon name="mdi:github" class="w-5 h-5" />
            Ver GitHub
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Abanico diagonal alineado a la derecha -->
      <div
        class="hidden md:block relative w-56 h-80 lg:w-64 lg:h-[22rem] flex-shrink-0 md:ml-auto mr-4 lg:mr-8"
        aria-hidden="true"
      >
        <!-- Arriba-izquierda -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-lg hover:scale-105 transition-transform"
          style="transform: translateY(-60%) translate(-25%, -40%) rotate(-12deg); z-index: 1;"
        >
          <img
            src="https://jaterli.com/images/proyectos/projects.easycryptobuy.jpg"
            alt="Proyecto EasyCryptoBuy"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <!-- Centro (al frente) -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-xl hover:scale-105 transition-transform"
          style="transform: translateY(-50%) translate(-5%, -5%) rotate(-2deg) scale(1.05); z-index: 3;"
        >
          <img
            src="https://jaterli.com/images/proyectos/projects.AnGoTest-proyecto-fin-master.webp"
            alt="Proyecto AnGoTest"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <!-- Abajo-derecha -->
        <div
          class="absolute top-1/2 right-4 w-48 lg:w-65 aspect-video overflow-hidden rounded-xl border border-base-300/60 shadow-lg hover:scale-105 transition-transform"
          style="transform: translateY(-50%) translate(10%, 55%) rotate(10deg); z-index: 2;"
        >
          <img
            src="https://jaterli.com/images/proyectos/projects.react-rickandmorty-explorer.webp"
            alt="Proyecto Rick and Morty Explorer en React"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
        CONTADOR DE RESULTADOS
  ============================================================ -->
  {
    page.total > 0 && (
      <div class="pt-[6rem] mt-[-3rem] flex items-center justify-between text-sm text-base-content/60" id="projects-list">
        <p>
          Mostrando del <strong class="text-base-content">{page.start + 1}</strong> al{" "}
          <strong class="text-base-content">{page.end + 1}</strong> de{" "}
          <strong class="text-base-content">{page.total}</strong> proyectos para <strong class="text-primary">#{tag}</strong>
        </p>
        <p>
          Página <strong class="text-base-content">{page.currentPage}</strong> de{" "}
          <strong class="text-base-content">{page.lastPage}</strong>
        </p>
      </div>
    )
  }

  <!-- ============================================================
        GRID DE PROYECTOS
  ============================================================ -->
  {
    page.data.length === 0 ? (
      <div class="mt-8 rounded-xl border border-base-300/60 bg-base-200/40 p-8 text-center">
        <Icon
          name="carbon:portfolio"
          class="w-10 h-10 mx-auto mb-3 text-base-content/30"
        />
        <h2 class="font-heading text-xl font-semibold mb-1">
          Sin proyectos para la etiqueta #{tag}
        </h2>
        <p class="text-base text-base-content/60">
          Actualmente no hay proyectos asignados a esta categoría.
        </p>
      </div>
    ) : (
      <section class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
        {page.data.map((project) => (
          <HorizontalProjectItem
            title={project.data.title}
            description={project.data.description}
            pubDate={project.data.pubDate}
            heroImage={project.data.heroImage}
            badge={project.data.badge}
            details={project.data.details}
            tags={project.data.tags}
            url={getProjectUrl(project.id)}
          />
        ))}
      </section>
    )
  }

  <!-- ============================================================
        PAGINACIÓN NUMÉRICA (MÁXIMO 3 BOTONES + RETROCEDER/AVANZAR)
  ============================================================ -->
  {
    page.lastPage > 1 && (
      <nav
        class="mt-12 pt-8 border-t border-base-300/60 flex justify-center"
        aria-label="Paginación de proyectos por etiqueta"
      >
        <ul class="flex items-center gap-2 flex-wrap justify-center">
          {/* Anterior */}
          <li>
            {page.url.prev ? (
              <a
                href={page.url.prev+"#projects-list"}
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                aria-label="Página anterior"
              >
                <Icon name="mdi:chevron-left" class="w-5 h-5" />
              </a>
            ) : (
              <span
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/40 bg-base-200/20 text-base-content/30 cursor-not-allowed"
                aria-hidden="true"
              >
                <Icon name="mdi:chevron-left" class="w-5 h-5" />
              </span>
            )}
          </li>

          {/* Números de página */}
          {pageNumbers.map((n) =>
            n === page.currentPage ? (
              <li>
                <span
                  class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-primary bg-primary text-primary-content text-sm font-semibold shadow-sm"
                  aria-current="page"
                >
                  {n}
                </span>
              </li>
            ) : (
              <li>
                <a
                  href={pageUrl(n, basePath)+"#projects-list"}
                  class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-sm font-medium text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                >
                  {n}
                </a>
              </li>
            )
          )}

          {/* Siguiente */}
          <li>
            {page.url.next ? (
              <a
                href={page.url.next+"#projects-list"}
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/60 bg-base-200/40 text-base-content/70 hover:bg-base-200 hover:border-primary/40 hover:text-primary transition-colors"
                aria-label="Página siguiente"
              >
                <Icon name="mdi:chevron-right" class="w-5 h-5" />
              </a>
            ) : (
              <span
                class="inline-flex items-center justify-center w-10 h-10 rounded-lg border border-base-300/40 bg-base-200/20 text-base-content/30 cursor-not-allowed"
                aria-hidden="true"
              >
                <Icon name="mdi:chevron-right" class="w-5 h-5" />
              </span>
            )}
          </li>
        </ul>
      </nav>
    )
  }
</BaseLayout>