---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import { getCollection } from "astro:content";
import { getProjectUrl } from "../../../../lib/getPostUrl";

export async function getStaticPaths({ paginate }) {
  const all_entries = await getCollection("projects");

  // Paso 1: Extraer todos los tags y normalizarlos a minúsculas
  const all_tags = [
    ...new Set(
      all_entries.flatMap((entry) => 
        (entry.data.tags || []).map(tag => tag.toLowerCase()) // Convertir cada tag a minúsculas
      )
    )
  ];

  // Paso 2: Generar las rutas paginadas
  return all_tags.flatMap((tag) => {
    const filtred_entries = all_entries
      .filter((entry) => 
        (entry.data.tags || [])
          .map(entryTag => entryTag.toLowerCase()) // Normalizar tags del entry a minúsculas
          .includes(tag) // Comparar con el tag en minúsculas
      )
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return paginate(filtred_entries, {
      params: { tag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;
---

<BaseLayout title={"Proyectos - " + params.tag} sideBarActiveItemID="proyectos">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Proyectos - {params.tag}</div>
    <div>Pág(s). {page.currentPage} de {page.lastPage}</div>
  </div>
  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-bold">Lo siento!</p>
        <p>Todavía no se han publicado proyectos.</p>
      </div>
    ) : (
      <ul>
        {page.data.map((entry) => (
          <>
            <HorizontalProjectItem
              title={entry.data.title}
              heroImage={entry.data.heroImage}
              description={entry.data.description}
              badge={entry.data.badge}
              pubDate={entry.data.pubDate}
              tags={entry.data.tags}
              url={getProjectUrl(entry)} 
              target="_self"
            />
            <div class="divider my-0" />
          </>
        ))}
      </ul>
    )
  }
  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          Entries más recientes
        </a>
      ) : <div />
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Entries más antiguos
          <svg class="h-6 w-6 fill-current md:h-8 md:w-8" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : <div />
    }
  </div>
</BaseLayout>
