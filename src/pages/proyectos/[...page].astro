---
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import generateSlug from "src/lib/generateUrlSlug";

export async function getStaticPaths({ paginate }) {
  const items = await getCollection("projects");

  items.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(items, { pageSize: 10 });
}

interface Page<T = any> {
  /** resultado */
  data: T[];
  /** metadatos */
  /** el recuento del primer elemento de la página, a partir de 0 */
  pubdate: number;
  /** el recuento del último elemento de la página, a partir de 0 */
  end: number;
  /** el número total de resultados */
  total: number;
  /** el número de la página actual, a partir de 1 */
  currentPage: number;
  /** el número de elementos por página (predeterminado: 25) */
  size: number;
  /** el número de la última página */
  lastPage: number;
  url: {
    /** la url de la página actual */
    current: string;
    /** la url de la página anterior (si hay alguna) */
    prev: string | undefined;
    /** la url de la página siguiente (si hay alguna) */
    next: string | undefined;
  };
}
const { page } = Astro.props as { page: Page };
---


<BaseLayout title="Proyectos de Programación" sideBarActiveItemID="proyectos">

  <h1>Proyectos de Programación</h1>
  <h2 class="w-full font-semibold mt-4">Portfolio de Desarrollo Web, APIs y Aplicaciones Blockchain</h2>
  
  <div class="mt-8 mb-3">Pág(s). {page.currentPage} de {page.lastPage}</div>

  {
    page.data.length === 0 ? (
      <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
        <p class="font-semibold">Lo siento!</p>
        <p>No hay proyectos publicados en este momento.</p>
      </div>
    ) : (
      <div>
        {page.data.map((entry) => (
          <>
          <HorizontalProjectItem
              title={entry.data.title}
              description={entry.data.description}
              pubDate={entry.data.pubDate}
              heroImage={entry.data.heroImage}
              badge={entry.data.badge}
              details={entry.data.details}
              tags={entry.data.tags}
              url={"/proyectos/entry/" + generateSlug(entry.slug)} // crea el slug basado en el nombre del fichero md
            />
            <div class="divider my-0" />
          </>
        ))}
      </div>
    )
  }

  <div class="flex justify-between">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
          {" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>{" "}
          Proyectos más recientes
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
          Proyectos más antiguos{" "}
          <svg
            class="h-6 w-6 fill-current md:h-8 md:w-8"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            {" "}
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>
</BaseLayout>
