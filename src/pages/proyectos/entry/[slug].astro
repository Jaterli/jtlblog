---
import { type CollectionEntry, getCollection } from "astro:content";
import ProjectItemLayout from "@layouts/ProjectLayout.astro";
import type { ProjectSchema } from "src/content/config";
import generateSlug from "src/lib/generateUrlSlug";

export async function getStaticPaths() {
  const itemEntries = await getCollection("projects");
  return itemEntries.map((entry) => ({
    params: { slug: generateSlug(entry.slug) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const item: ProjectSchema = entry.data;
const { Content } = await entry.render();
---

<ProjectItemLayout
  title={item.title}
  description={item.description}
  pubDate={item.pubDate}
  heroImage={item.heroImage}
  jsonLd={item.jsonLd}
  badge={item.badge}
  tags={item.tags}
>
  <Content />
</ProjectItemLayout>
