---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectItemLayout from "@layouts/ProjectLayout.astro";
import generateSlug from "src/lib/generateUrlSlug";

export async function getStaticPaths() {
  const itemEntries = await getCollection("projects");
  
  return itemEntries.map((entry) => ({
    params: { slug: generateSlug(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props as Props;
const item = entry.data;
const { Content } = await render(entry);
---

<ProjectItemLayout
  title={item.title}
  description={item.description}
  pubDate={item.pubDate}
  heroImage={item.heroImage}
  jsonLd={item.jsonLd}
  badge={item.badge}
  tags={item.tags}
>
  <Content />
</ProjectItemLayout>
