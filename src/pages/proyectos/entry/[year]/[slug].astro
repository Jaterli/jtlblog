---
import { getCollection, render } from "astro:content";
import ProjectItemLayout from "@layouts/ProjectLayout.astro";
import generateSlug from "@lib/generateUrlSlug";

export async function getStaticPaths() {
  const postEntries = await getCollection("projects");

  return postEntries.map((entry: any) => {
    const [year, slugPart] = entry.id.split("/");
    const slug = generateSlug(slugPart);

    return {
      params: { year, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props as { entry: any };
const item = entry.data;
const { Content } = await render(entry);
---

<ProjectItemLayout
  title={item.title}
  description={item.description}
  pubDate={item.pubDate}
  heroImage={item.heroImage}
  jsonLd={item.jsonLd}
  badge={item.badge}
  tags={item.tags}
>
  <Content />
</ProjectItemLayout>
