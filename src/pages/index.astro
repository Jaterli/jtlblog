---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import { getCollection } from "astro:content";
import { getPostUrl } from "@lib/getPostUrl";
import { getProjectUrl } from "@lib/getProjectUrl";
import { Icon } from "astro-icon/components";

import tasksData from "../data/tasks.json";

const title = "Jaime TL — Full Stack & Blockchain Developer";
const description =
  "Más de 20 años construyendo soluciones web. Desarrollo Full Stack, Blockchain y automatización con foco en eficiencia, escalabilidad y buenas prácticas.";
const image = "/images/others/profile-photo.webp";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const projects = (await getCollection("projects")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const last_posts = posts.slice(0, 3);
const last_projects = projects.slice(0, 3);

const tasks = tasksData.tasks;
const lastTasks = tasks
  .filter((task) => task.startDay)
  .sort(
    (a, b) => new Date(b.startDay).getTime() - new Date(a.startDay).getTime()
  )
  .slice(0, 3);

// Stack principal para el hero
const stack = [
  "Python", "Django", "TypeScript", "React", "Angular", "Astro",
  "Node.js", "Solidity", "PostgreSQL", "Docker", "Tailwind", "WordPress",
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  sideBarActiveItemID="home"
>
  <!-- ============================================================
       HERO
  ============================================================ -->
  <section
    class="relative overflow-hidden rounded-2xl border-2 border-base-300 bg-base-200/80 shadow-md mb-10"
  >
    <div
      class="absolute inset-0 opacity-[0.04] pointer-events-none bg-[url('/images/others/hero-pattern.svg')] bg-cover bg-center"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div
      class="relative grid lg:grid-cols-[1.4fr_1fr] gap-8 lg:gap-12 items-center px-4 sm:px-10 py-10 sm:py-14"
    >
      <!-- Columna izquierda: texto -->
      <div class="space-y-6 text-center lg:text-left">
        <span
          class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-primary/20 bg-primary/10 text-xs font-semibold text-primary"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Disponible para nuevos proyectos
        </span>

        <h1
          class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-base-content"
        >
          Hola, soy <span class="text-primary">Jaime TL</span><br />
          Construyo productos web
          <span class="text-base-content/70">full stack y blockchain.</span>
        </h1>

        <p class="text-base sm:text-lg text-base-content/80 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Más de <strong class="text-base-content">20 años de experiencia</strong> creando
          plataformas seguras, escalables y automatizadas. Del backend con
          Django y Node.js al frontend con React, Angular y Astro — pasando por
          contratos inteligentes en Solidity.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start pt-2">
          <a
            href="/proyectos/"
            class="btn btn-primary rounded-lg px-6 shadow-sm hover:shadow-md transition-all inline-flex items-center gap-2"
          >
            <Icon name="carbon:portfolio" class="w-5 h-5" />
            Ver proyectos
          </a>
          <a
            href="/contacto/"
            class="btn btn-outline rounded-lg px-6 bg-base-100 border-base-300 inline-flex items-center gap-2"
          >
            <Icon name="mdi:email-outline" class="w-5 h-5" />
            Contactar
          </a>
        </div>

        <!-- Stack chips -->
        <div class="pt-4 border-t border-base-300/80">
          <p class="text-xs font-bold uppercase tracking-wider text-base-content/60 mb-3">
            Stack principal
          </p>
          <ul class="flex flex-wrap gap-1.5 justify-center lg:justify-start">
            {stack.map((tech) => (
              <li class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-100 border border-base-300 text-base-content/80 font-medium">
                {tech}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Columna derecha: foto -->
      <div class="relative flex justify-center">
        <div class="relative">
          <div
            class="absolute inset-0 rounded-full bg-gradient-to-tr from-primary/20 to-transparent blur-2xl scale-110"
            aria-hidden="true"
          ></div>
          <img
            src="/images/others/profile-photo.webp"
            alt="Foto de perfil de Jaime TL"
            width="320"
            height="320"
            loading="eager"
            class="relative w-56 h-56 sm:w-72 sm:h-72 rounded-full object-cover ring-4 ring-base-100 shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SOBRE MÍ (resumen del CV)
  ============================================================ -->
  <section class="mt-12 grid md:grid-cols-3 gap-6">
    {
      [
        {
          icon: "mdi:briefcase-outline",
          title: "20+ años",
          desc: "Desarrollando aplicaciones web empresariales para gestión de traductores y grandes proyectos.",
        },
        {
          icon: "mdi:school-outline",
          title: "Doble Máster",
          desc: "Especializado en Full Stack y Blockchain por Conquer Blocks. Formación técnica en constante evolución.",
        },
        {
          icon: "mdi:code-braces",
          title: "Full Stack + Web3",
          desc: "Dominio de Django, Node, React, Angular, Astro, PostgreSQL, Docker y smart contracts en Solidity.",
        },
      ].map((item) => (
        <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-6 shadow-sm hover:border-primary/50 transition-colors">
          <div class="p-2.5 rounded-xl bg-base-100 border border-base-300 text-primary w-fit mb-4">
            <Icon name={item.icon} class="w-6 h-6" />
          </div>
          <h3 class="font-heading font-bold text-lg text-base-content mb-2">{item.title}</h3>
          <p class="text-sm sm:text-base text-base-content/80 leading-relaxed">{item.desc}</p>
        </div>
      ))
    }
  </section>

  <!-- ============================================================
       PROYECTO DESTACADO AMPLIO (AnGoTest)
  ============================================================ -->
  <section class="mt-16">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-primary text-primary-content shadow-xs">
          <Icon name="mdi:star-outline" class="w-6 h-6" />
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Trabajo Fin de Máster</span>
          <h2 class="font-heading text-2xl sm:text-3xl font-bold text-base-content">Proyecto Destacado</h2>
        </div>
      </div>
      <a
        href="/proyectos/entry/2026/angotest-plataforma-completa-de-tests-online-con-django-angular-e-ia/"
        class="btn btn-sm btn-ghost border border-primary/20 text-primary font-semibold hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-200 hidden sm:inline-flex items-center gap-1.5"
      >
        <span>Ver proyecto detallado</span>
        <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <article class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 shadow-sm overflow-hidden">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <!-- Columna Izquierda: Imagen del proyecto -->
        <div class="lg:col-span-5 relative group">
          <div class="overflow-hidden rounded-xl border-2 border-base-300 bg-base-100 shadow-md">
            <img
              src="/images/proyectos/projects.AnGoTest-proyecto-fin-master.webp"
              alt="AnGoTest - Plataforma de Tests Online con Django, Angular e IA"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
        </div>

        <!-- Columna Derecha: Explicación Detallada -->
        <div class="lg:col-span-7 flex flex-col justify-between space-y-5">
          <div>
            <h3 class="font-heading text-2xl sm:text-3xl font-bold text-base-content mb-3 leading-snug">
              Plataforma Completa de Tests Online con IA
            </h3>
            <p class="text-xs sm:text-sm text-base-content/80 leading-relaxed mb-4">
              Aplicación web <strong>Full-Stack</strong> de alto rendimiento diseñada como Trabajo Fin de Máster. Resuelve las limitaciones de la evaluación tradicional ofreciendo corrección instantánea, ranking de usuarios, dashboard de administración interactivo y <strong>generación de pruebas personalizadas mediante Inteligencia Artificial</strong>.
            </p>

            {/* Características clave destacadas */}
            <ul class="space-y-2 text-xs sm:text-sm text-base-content/80 mb-5">
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span><strong>Seguridad Avanzada:</strong> Autenticación JWT mediante cookies <code class="bg-base-100 px-1 py-0.5 rounded border border-base-300 font-mono text-xs">HttpOnly</code>, <code class="bg-base-100 px-1 py-0.5 rounded border border-base-300 font-mono text-xs">SameSite=Strict</code> y protección CORS.</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span><strong>Generación con IA & Cuotas:</strong> Creación automática de cuestionarios estructurados mediante Llama/Mistral con límites de consumo por usuario.</span>
              </li>
              <li class="flex items-start gap-2">
                <Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span><strong>Arquitectura Dockerizada:</strong> Frontend reactivo en Angular 20, API REST en Django 5 y PostgreSQL orquestados con Docker Compose.</span>
              </li>
            </ul>

            {/* Badges de tecnologías */}
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-base-300/80">
              {["Django REST", "Angular", "Groq AI", "PostgreSQL", "Docker", "JWT", "TailwindCSS"].map((t) => (
                <span class="font-mono text-xs px-2.5 py-1 rounded-md bg-base-100 border border-base-300 text-base-content/80 font-medium">
                  {t}
                </span>
              ))}
            </div>
          </div>

          {/* Acciones principales */}
          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="/proyectos/entry/2026/angotest-plataforma-completa-de-tests-online-con-django-angular-e-ia/"
              class="btn btn-primary rounded-lg px-5 shadow-sm inline-flex items-center gap-2"
            >
              <Icon name="mdi:file-document-outline" class="w-5 h-5" />
              <span>Leer artículo completo</span>
            </a>
            <a
              href="https://www.youtube.com/watch?v=JOpi1MysM9g"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline rounded-lg bg-base-100 border-base-300 inline-flex items-center gap-2"
            >
              <Icon name="mdi:youtube" class="w-5 h-5 text-red-600" />
              <span>Ver vídeo demostración</span>
            </a>
            <a
              href="/projects/angotest/AngoTest_Documentacion_Tecnica.pdf"
              target="_blank"
              class="btn btn-ghost rounded-lg border border-base-300 inline-flex items-center gap-2 text-xs"
            >
              <Icon name="mdi:file-pdf-box" class="w-5 h-5 text-primary" />
              <span>Documentación PDF</span>
            </a>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- ============================================================
       ÚLTIMOS POSTS
  ============================================================ -->
  <section class="mt-16">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-base-200 border border-base-300 text-primary">
          <Icon name="mdi:blog-outline" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Últimas publicaciones</h2>
          <p class="text-xs text-base-content/70">Artículos técnicos sobre desarrollo, IA y Web3</p>
        </div>
      </div>
      <a 
        href="/blog/" 
        class="btn btn-sm btn-ghost border border-primary/20 text-primary font-semibold hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-200 inline-flex items-center gap-1.5"
      >
        <span>Ver todos los posts</span>
        <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        last_posts.map((post: any) => (
          <HorizontalCard
            title={post.data.title}
            heroImage={post.data.heroImage}
            description={post.data.description}
            badge={post.data.badge}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            url={getPostUrl(post.id)}
            target="_self"
          />
        ))
      }
    </div>
  </section>

  <!-- ============================================================
       ÚLTIMOS PROYECTOS
  ============================================================ -->
  <section class="mt-16">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-base-200 border border-base-300 text-primary">
          <Icon name="carbon:portfolio" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Últimos proyectos</h2>
          <p class="text-xs text-base-content/70">Trabajos recientes e investigaciones prácticas</p>
        </div>
      </div>
      <a 
        href="/proyectos/" 
        class="btn btn-sm btn-ghost border border-primary/20 text-primary font-semibold hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-200 inline-flex items-center gap-1.5"
      >
        <span>Ver todos los proyectos</span>
        <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        last_projects.map((project: any) => (
          <HorizontalProjectItem
            title={project.data.title}
            heroImage={project.data.heroImage}
            description={project.data.description}
            badge={project.data.badge}
            pubDate={project.data.pubDate}
            tags={project.data.tags}
            url={getProjectUrl(project.id)}
            target="_self"
          />
        ))
      }
    </div>
  </section>

  <!-- ============================================================
        TAREAS EN CURSO
    ============================================================ -->
  <section class="mt-16">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-base-200 border border-base-300 text-primary">
          <Icon name="mdi:clipboard-list-outline" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Tareas en curso</h2>
          <p class="text-xs text-base-content/70">Estado de aprendizaje y objetivos activos</p>
        </div>
      </div>
      <a 
        href="/tasks/" 
        class="btn btn-sm btn-ghost border border-primary/20 text-primary font-semibold hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-200 inline-flex items-center gap-1.5"
      >
        <span>Ver todas las tareas</span>
        <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        lastTasks.map((task) => {
          const isPending = !task.endDay || new Date(task.endDay) > new Date();
          return (
            <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-5 shadow-sm hover:border-primary/50 transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-start gap-3 mb-2">
                  <div class={`p-1.5 rounded-lg shrink-0 mt-0.5 ${isPending ? 'bg-warning/10 text-warning border border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20'}`}>
                    <Icon name={isPending ? "mdi:clock-outline" : "mdi:check-circle-outline"} class="w-5 h-5" />
                  </div>
                  <h3 class="font-heading font-bold text-base text-base-content leading-snug">
                    {task.description}
                  </h3>
                </div>
                {task.details && (
                  <p class="text-xs text-base-content/80 leading-relaxed mb-3">
                    {task.details}
                  </p>
                )}
              </div>

              <div class="flex items-center gap-1.5 pt-3 mt-2 border-t border-base-300/80 font-mono text-xs text-base-content/60">
                <Icon name="mdi:calendar-month-outline" class="w-4 h-4 text-primary shrink-0" />
                <span>
                  {task.startDay
                    ? new Date(task.startDay).toLocaleDateString("es-ES")
                    : "Sin fecha"}
                  {task.endDay &&
                    task.endDay !== task.startDay &&
                    ` → ${new Date(task.endDay).toLocaleDateString("es-ES")}`}
                </span>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- ============================================================
       GRÁFICA DE PUBLICACIONES
  ============================================================ -->
  <section
    class="mt-16 mb-8 rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 text-center shadow-sm"
  >
    <div class="flex justify-center mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
        Estadísticas del Sitio
      </span>
    </div>
    <h2 class="font-heading text-2xl font-bold text-base-content mb-6">
      Publicaciones por Mes
    </h2>
    <div class="bg-base-100 p-4 rounded-xl border border-base-300 inline-block max-w-full">
      <img
        src="https://raw.githubusercontent.com/Jaterli/fastAPI/main/grap.png"
        title="N.º posts por Mes"
        alt="Gráfica de número de publicaciones por mes"
        class="grap mx-auto max-w-full h-auto rounded-lg"
        loading="lazy"
      />
    </div>
    <p class="mt-5 text-xs sm:text-sm text-base-content/70">
      Gráfica automatizada y generada con{" "}
      <a
        class="text-primary font-semibold hover:underline"
        href="/proyectos/entry/2024/creacion-de-grafica-de-barras-con-streamlit"
      >
        Streamlit & Python
      </a>
    </p>
  </section>
</BaseLayout>