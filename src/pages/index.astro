---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = (await getCollection("proyectos")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
const last_projects = projects.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">

    <div class="bg-base-200 py-12 px-6 text-base text-center">

      <h1 class="text-4xl font-bold mb-6">¡Hola! Soy Jaime 👋</h1>
      <p class="text-lg mb-6">
        Desarrollador web con más de <strong>20 años de experiencia</strong> combinando gestión de proyectos y desarrollo de soluciones tecnológicas. He creado plataformas innovadoras, como una herramienta de gestión de traductores con filtrado avanzado, que optimizaron procesos y mejoraron la eficiencia.
      </p>
      <p class="text-lg mb-6">
        Actualmente, amplío mis conocimientos con un <strong>Máster en Desarrollo Full Stack</strong> y un <strong>Máster en Desarrollo Blockchain</strong>. Mi enfoque es la eficiencia, la automatización y soluciones que generen valor.
      </p>
      <p class="text-lg mb-8">
        En este blog comparto mis proyectos y experiencias como desarrollador. ¡Explora mis creaciones y descubre cómo puedo ayudarte a materializar tus ideas!
      </p>
      <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
        <a href="proyectos" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-100 transition duration-300 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
          </svg>
          Ver mis proyectos
        </a>
        <a href="contacto" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-100 transition duration-300 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
          </svg>
          Contacto
        </a>
      </div>
    </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-12">Últimos posts</div>
  </div>
  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          description={post.data.description}
          badge={post.data.badge}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Últimos proyectos &#60;/&#62;</div>
  </div>
  {
    last_projects.map((project) => (
      <>
        <HorizontalCard
          title={project.data.title}
          img={project.data.heroImage}
          description={project.data.description}
          badge={project.data.badge}
          pubDate={project.data.pubDate}
          tags={project.data.tags}
          url={"/proyectos/" + createSlug(project.data.title, project.slug)}
          target="_self"
        />
        <div class="divider my-0" />
      </>
    ))
  }

<div>&nbsp;</div>

<div class="mb-14 text-center">
  <div class="text-3xl w-full font-bold mb-5 mt-10">Nº posts por Mes</div>
  <img src="https://raw.githubusercontent.com/Jaterli/fastAPI/main/grap.png" title="Nº posts por Mes" alt="Nº posts por Mes" class="grap" />    
  <div class="mt-4">Gráfica desarrollada con Streamlit</div>
</div>

</BaseLayout>

<style>
  .grap{
    width: 400px;
    display: inline;
  }
</style>