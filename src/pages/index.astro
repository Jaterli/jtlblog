  <!-- LÓGICA DEL CARRUSEL Y REVEAL ON SCROLL -->
  <script>
    function setupTipsSlider() {
      const track = document.getElementById("tips-slider-track");
      const prevBtn = document.getElementById("prev-tip-btn");
      const nextBtn = document.getElementById("next-tip-btn");
      const indicators = document.querySelectorAll(".indicator-btn");

      if (!track || indicators.length === 0) return;

      let currentIndex = 0;
      const totalSlides = indicators.length;

      function updateSlider(index: number) {
        if (!track) return;

        currentIndex = (index + totalSlides) % totalSlides;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        indicators.forEach((btn, i) => {
          if (i === currentIndex) {
            btn.classList.add("bg-primary", "w-6");
            btn.classList.remove("bg-base-300", "w-2.5");
          } else {
            btn.classList.add("bg-base-300", "w-2.5");
            btn.classList.remove("bg-primary", "w-6");
          }
        });
      }

      prevBtn?.addEventListener("click", () => updateSlider(currentIndex - 1));
      nextBtn?.addEventListener("click", () => updateSlider(currentIndex + 1));

      indicators.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          const idx = parseInt(target.getAttribute("data-index") || "0", 10);
          updateSlider(idx);
        });
      });

      // Inicializar primer slide
      updateSlider(0);
    }

    function initReveal() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
      );

      document
        .querySelectorAll(".reveal-on-scroll:not(.visible)")
        .forEach((el) => observer.observe(el));
    }

    function initPage() {
      initReveal();
      setupTipsSlider();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPage);
    } else {
      initPage();
    }

    document.addEventListener("astro:page-load", initPage);
  </script>

