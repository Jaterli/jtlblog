---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { getPostUrl } from "src/lib/getPostUrl";
import generateSlug from "src/lib/generateUrlSlug";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = (await getCollection("projects")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
const last_projects = projects.slice(0, 3);
---

<BaseLayout title="Bienvenid@ a mi blog personal" sideBarActiveItemID="home">
  <div class="bg-base-200 rounded-xl shadow-sm py-8 sm:py-12 px-4 sm:px-6 text-base text-center">

    <h1 class="sm:font-semibold font-normal mb-4">Bienvenid@ a mi blog personal 👋</h1>
    <p class="sm:text-lg text-base mb-6">
      Este espacio está dedicado a compartir los conocimientos adquiridos en mis estudios de desarrollo full stack y blockchain: proyectos que voy construyendo, artículos sobre temas de actualidad en tecnología y soluciones a problemas comunes en desarrollo web y blockchain.       
    </p>

    <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
      <a href="proyectos" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-200 transition duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
          <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
        </svg>
        Ver proyectos
      </a>
      <a href="contacto" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-200 transition duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        Contacto
      </a>
    </div>
  </div>

  <!-- Publicación destacada -->
  <article class="max-w-3xl mt-12">
    <h2 class="w-full font-bold mb-5 mt-12">¿Cón qué estoy ahora?</h2>
    <h3 class="mb-4">Mi próximo reto es el de completar los módulos pendientes de HTML y CSS</h3>

    <p>Tras finalizar con éxito mi <a href="/proyectos/entry/proyecto-final-de-modulo--desarrollo-de-web-corporativa-en-wordpress" title="proyecto final de módulo de WordPress" class="customlink">proyecto final de módulo de WordPress</a>, mi siguiente objetivo dentro del máster en Desarrollo Full Stack impartido por Academia Conquer Blocks es ponerme al día con los módulos que tengo pendientes, concretamente HTML y CSS.</p>

    <p class="py-4">Son lenguajes que manejo con soltura desde hace tiempo, tanto que en su momento decidí avanzar directamente a módulos más complejos. Sin embargo, la Academia exige — de forma totalmente comprensible — que también complete los tests y proyectos prácticos de estos módulos para poder otorgarme el título final de Máster.</p>

    <p>Ahora es momento de retomar esas bases, no solo para cumplir con los requisitos académicos, sino también para reforzar y perfeccionar las habilidades que todo desarrollador debe dominar.</p>

  </article>

  <div class="divider my-0 pt-4" />

  <h2 class="w-full font-bold mb-5 mt-12">Últimos posts</h2>
  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          heroImage={post.data.heroImage}
          description={post.data.description}
          badge={post.data.badge}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          url={getPostUrl(post.slug)}
          target="_self"
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <h2 class="w-full font-bold mb-5 mt-10">Últimos proyectos &#60;/&#62;</h2>
  {
    last_projects.map((project) => (
      <>
        <HorizontalProjectItem
          title={project.data.title}
          heroImage={project.data.heroImage}
          description={project.data.description}
          badge={project.data.badge}
          pubDate={project.data.pubDate}
          tags={project.data.tags}
          url={"/proyectos/entry/" + generateSlug(project.slug)}
          target="_self"
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div>&nbsp;</div>

  <div class="mb-14 text-center">
    <div class="text-2xl w-full font-bold mb-5 mt-10">N.º publicaciones por Mes</div>
    <img src="https://raw.githubusercontent.com/Jaterli/fastAPI/main/grap.png" title="Nº posts por Mes" alt="Nº posts por Mes" class="grap" />    
    <div class="mt-4">Gráfica desarrollada con <a class="text-blue-500 underline" href="/proyectos/entry/creacion-de-grafica-de-barras-con-streamlit">Streamlit</a></div>
  </div>
</BaseLayout>

<style>
  .grap {
    width: 400px;
    display: inline;
  }
</style>
