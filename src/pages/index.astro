  <script>
    /* ============================================================
       TIPING EFFECT
    ============================================================ */
    function setupTypingEffect(): void {
      const target = document.getElementById("typing-skill-target");
      if (!target || target.dataset.ready === "true") return;
      target.dataset.ready = "true";

      let skills: string[] = [];
      try {
        skills = JSON.parse(target.dataset.skills || "[]");
      } catch {
        skills = [];
      }
      if (!skills.length) return;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        target.textContent = skills[0];
        return;
      }

      const el = target;
      const TYPE_SPEED = 65;
      const DELETE_SPEED = 30;
      const HOLD_AFTER_TYPE = 2200;
      const HOLD_AFTER_DELETE = 400;

      let skillIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      function tick(): void {
        const currentSkill = skills[skillIndex];

        if (!isDeleting) {
          charIndex++;
          el.textContent = currentSkill.slice(0, charIndex);
          if (charIndex >= currentSkill.length) {
            isDeleting = true;
            setTimeout(tick, HOLD_AFTER_TYPE);
            return;
          }
          setTimeout(tick, TYPE_SPEED);
        } else {
          charIndex--;
          el.textContent = currentSkill.slice(0, charIndex);
          if (charIndex <= 0) {
            isDeleting = false;
            skillIndex = (skillIndex + 1) % skills.length;
            setTimeout(tick, HOLD_AFTER_DELETE);
            return;
          }
          setTimeout(tick, DELETE_SPEED);
        }
      }

      tick();
    }

    /* ============================================================
       SLIDER 1-a-1 (idempotente)
    ============================================================ */
    interface SliderOptions {
      trackId: string;
      prevId: string;
      nextId: string;
      indicatorClass: string;
      autoPlay?: boolean;
      intervalTime?: number;
    }

    function setupSlider({
      trackId,
      prevId,
      nextId,
      indicatorClass,
      autoPlay = false,
      intervalTime = 10000,
    }: SliderOptions): void {
      const track = document.getElementById(trackId);
      if (!track || track.dataset.ready === "true") return;

      const indicators = Array.from(
        document.querySelectorAll<HTMLElement>(`.${indicatorClass}`)
      );
      if (indicators.length === 0) return;

      track.dataset.ready = "true";

      const totalSlides = indicators.length;
      let currentIndex = 0;
      let autoPlayTimer: ReturnType<typeof setInterval> | null = null;

      function updateSlider(index: number): void {
        currentIndex = ((index % totalSlides) + totalSlides) % totalSlides;
        track!.style.transform = `translateX(-${currentIndex * 100}%)`;

        for (let i = 0; i < totalSlides; i++) {
          const btn = indicators[i];
          const isActive = i === currentIndex;
          btn.classList.toggle("bg-primary", isActive);
          btn.classList.toggle("w-6", isActive);
          btn.classList.toggle("bg-base-300", !isActive);
          btn.classList.toggle("w-2.5", !isActive);
        }
      }

      function startAutoPlay(): void {
        if (!autoPlay || autoPlayTimer) return;
        autoPlayTimer = setInterval(
          () => updateSlider(currentIndex + 1),
          intervalTime
        );
      }

      function stopAutoPlay(): void {
        if (!autoPlayTimer) return;
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }

      function resetAutoPlay(): void {
        if (!autoPlay) return;
        stopAutoPlay();
        startAutoPlay();
      }

      document.getElementById(prevId)?.addEventListener("click", () => {
        updateSlider(currentIndex - 1);
        resetAutoPlay();
      });

      document.getElementById(nextId)?.addEventListener("click", () => {
        updateSlider(currentIndex + 1);
        resetAutoPlay();
      });

      for (let i = 0; i < totalSlides; i++) {
        const btn = indicators[i];
        btn.addEventListener("click", () => {
          updateSlider(i);
          resetAutoPlay();
        });
      }

      if (autoPlay) {
        const sliderContainer = track.parentElement?.parentElement;
        sliderContainer?.addEventListener("mouseenter", stopAutoPlay, { passive: true });
        sliderContainer?.addEventListener("mouseleave", startAutoPlay, { passive: true });
      }

      updateSlider(0);
      startAutoPlay();
    }

    /* ============================================================
       REVEAL ON SCROLL (idempotente)
    ============================================================ */
    function initReveal(): void {
      const targets = document.querySelectorAll<HTMLElement>(
        ".reveal-on-scroll:not(.visible)"
      );
      if (targets.length === 0) return;

      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
      );

      targets.forEach((el) => observer.observe(el));
    }

    /* ============================================================
       INIT
    ============================================================ */
    function initPage(): void {
      initReveal();
      setupTypingEffect();

      setupSlider({
        trackId: "tips-slider-track",
        prevId: "prev-tip-btn",
        nextId: "next-tip-btn",
        indicatorClass: "indicator-btn",
        autoPlay: true,
        intervalTime: 10000,        
      });

      setupSlider({
        trackId: "skills-slider-track",
        prevId: "prev-skill-btn",
        nextId: "next-skill-btn",
        indicatorClass: "skill-indicator-btn",
      });
    }

    // Astro dispara 'astro:page-load' también en la carga inicial, así que
    // no hace falta registrar también DOMContentLoaded (evita doble init).
    document.addEventListener("astro:page-load", initPage);

    // Fallback por si el script se ejecuta fuera de Astro (tests, Storybook).
    if (document.readyState === "complete") {
      initPage();
    }
  </script>
</BaseLayout>