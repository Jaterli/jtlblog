---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import { getCollection } from "astro:content";
import { getPostUrl } from "@lib/getPostUrl";
import { getProjectUrl } from "@lib/getProjectUrl";
import { Icon } from "astro-icon/components";
import { getStore } from "@netlify/blobs"; // Importar SDK de Netlify Blobs

import tasksData from "../data/tasks.json";

const title = "Jaime TL — Full Stack, IA & Blockchain Developer";
const description =
  "Más de 20 años construyendo soluciones web. Desarrollo Full Stack, Blockchain y automatización con foco en eficiencia, escalabilidad y buenas prácticas.";
const image = "/images/others/profile-photo.webp";

const posts = (await getCollection("blog")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const projects = (await getCollection("projects")).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const last_posts = posts.slice(0, 3);
const last_projects = projects.slice(0, 3);

const tasks = tasksData.tasks;
const lastTasks = tasks
  .filter((task) => task.startDay)
  .sort(
    (a, b) => new Date(b.startDay).getTime() - new Date(a.startDay).getTime()
  )
  .slice(0, 3);

// ============================================================
// OBTENCIÓN DE DEV TIPS DESDE NETLIFY BLOBS
// ============================================================
interface DevTip {
  title: string;
  summary: string;
  category: string;
  source: string;
  url: string;
}

interface DevTipsResponse {
  date?: string;
  generatedAt?: string;
  tips?: DevTip[];
}

let devTipsData: DevTipsResponse = { tips: [], date: "" };

try {
  // Conectar con la tienda de Netlify Blobs (ajusta el 'name' al nombre de tu store o usa el predeterminado)
  const tipsStore = getStore("dev-tips"); 
  
  // Obtener el JSON almacenado (ajusta 'latest' o el nombre de clave que estés utilizando)
  const data = await tipsStore.get("latest", { type: "json" });
  
  if (data) {
    devTipsData = data as DevTipsResponse;
  }
} catch (error) {
  console.error("Error al obtener Dev Tips desde Netlify Blobs:", error);
}

const devTips: DevTip[] = (devTipsData.tips || []).slice(0, 5);
const devTipsDate = devTipsData.date || "";

// Helper para colores por categoría
const getCategoryBadgeClass = (category: string) => {
  switch (category?.toLowerCase()) {
    case "ia":
      return "bg-purple-500/10 text-purple-600 border-purple-500/20";
    case "css":
      return "bg-blue-500/10 text-blue-600 border-blue-500/20";
    case "herramientas":
      return "bg-amber-500/10 text-amber-600 border-amber-500/20";
    case "rendimiento":
      return "bg-emerald-500/10 text-emerald-600 border-emerald-500/20";
    default:
      return "bg-primary/10 text-primary border-primary/20";
  }
};

// Stack principal
const stack = [
  "Python", "Django", "TypeScript", "React", "Angular", "Astro",
  "Node.js", "Solidity", "PostgreSQL", "Docker", "TailwindCSS", "FastAPI", "AI", "WordPress"
];

const stats = [
  { label: "Experiencia", value: "+20 Años" },
  { label: "Especialidades", value: "Full Stack & Web3" },
  { label: "Arquitectura", value: "Docker & Cloud" },
  { label: "Enfoque", value: "IA & Automatización" },
];

import postsByMonthData from "../data/postsByMonth.json";

const allMonths = Array.from(
  new Set([
    ...Object.keys(postsByMonthData.blog || {}),
    ...Object.keys(postsByMonthData.projects || {}),
  ])
).sort();

const blogCounts: Record<string, number> = postsByMonthData.blog;
const projectCounts: Record<string, number> = postsByMonthData.projects;

const selectedMonths = allMonths.slice(-12);

const maxTotal = Math.max(
  ...selectedMonths.map(
    (m) => (blogCounts[m] || 0) + (projectCounts[m] || 0)
  ),
  1
);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  sideBarActiveItemID="home"
>
  <!-- ============================================================
        HERO SECTION PRINCIPAL (HOME IMPACT)
  ============================================================ -->
  <section
    class="relative overflow-hidden rounded-3xl border-2 border-base-300 bg-linear-to-br from-base-200/90 via-base-100 to-base-200/90 shadow-xl mb-10 reveal-on-scroll"
  >
    <div class="absolute inset-0 opacity-[0.05] pointer-events-none bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:16px_16px]" aria-hidden="true"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-primary/15 blur-3xl pointer-events-none animate-pulse" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 rounded-full bg-secondary/15 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div
      class="relative grid lg:grid-cols-[1.3fr_1fr] gap-10 items-center px-4 sm:px-12 py-12 sm:py-16"
    >
      <div class="space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-primary/30 bg-primary/10 text-xs font-semibold text-primary shadow-xs">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          Disponible para proyectos & consultoría
        </div>

        <h1
          class="font-heading text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-base-content"
        >
          Desarrollo <span class="text-transparent bg-clip-text bg-linear-to-r from-primary via-blue-500 to-secondary">Full Stack</span>, IA & Blockchain
        </h1>

        <p class="text-lg text-base-content/80 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Más de <strong class="text-base-content">20 años de experiencia</strong> transformando arquitecturas complejas en productos digitales de alto rendimiento, seguros y automatizados.
        </p>
     
        <div class="flex flex-wrap gap-4 justify-center lg:justify-start pt-2">
          <a
            href="/proyectos/"
            class="btn btn-primary rounded-lg px-7 shadow-md hover:shadow-primary/20 hover:scale-105 transition-all duration-200 inline-flex items-center gap-2 group"
          >
            <Icon name="carbon:portfolio" class="w-5 h-5 group-hover:rotate-12 transition-transform" />
            Explorar Proyectos
          </a>
          <a
            href="/contacto/"
            class="btn btn-outline rounded-lg px-7 bg-base-200/80 backdrop-blur-xs border-base-300 hover:border-primary/50 hover:bg-base-200 hover:scale-105 transition-all duration-200 inline-flex items-center gap-2"
          >
            <Icon name="mdi:email-outline" class="w-5 h-5 text-primary" />
            Contactar
          </a>
        </div>
      </div>

      <div class="relative flex flex-col items-center justify-center">
        <div class="w-full max-w-md rounded-2xl border border-base-300 bg-base-300/60 backdrop-blur-md shadow-2xl overflow-hidden font-mono text-xs">
          <div class="flex items-center justify-between px-4 py-2.5 bg-base-300/90 border-b border-base-300">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <span class="text-base-content/60 font-semibold text-[11px]">jaime@jaterli: ~</span>
            <Icon name="mdi:console" class="w-4 h-4 text-base-content/40" />
          </div>

          <div class="p-5 space-y-3 bg-base-100/90 text-base-content/90">
            <div class="flex gap-2">
              <span class="text-primary font-bold">❯</span>
              <span class="text-secondary font-semibold">whoami</span>
            </div>
            <p class="text-base-content/70 pl-4 border-l-2 border-primary/40">
              Jaime TL — Sr. Full Stack & Web3 Engineer
            </p>

            <div class="flex gap-2 pt-1">
              <span class="text-primary font-bold">❯</span>
              <span class="text-secondary font-semibold">cat skills.json</span>
            </div>
            <div class="pl-4 text-emerald-600 dark:text-emerald-400 font-mono text-[11px]/5">
              &#123; "frontend" : ["React", "Angular"], "backend": ["Django", "Node"], "web3": ["Solidity", "EVM"], "ai": ["LLMs", "RAG"] &#125;
            </div>

            <div class="flex gap-2 pt-1 items-center">
              <span class="text-primary font-bold">❯</span>
              <span class="text-secondary font-semibold">status</span>
              <span class="inline-block w-2 h-4 bg-primary animate-pulse"></span>
            </div>
          </div>
        </div>

        <div class="relative -mt-8 flex items-center gap-3 bg-base-100/90 border-2 border-base-300 rounded-full py-1.5 px-4 shadow-lg backdrop-blur-md">
          <img
            src="/images/others/profile-photo.webp"
            alt="Foto de Jaime TL"
            class="w-10 h-10 rounded-full object-cover ring-2 ring-primary"
          />
          <div class="text-left">
            <p class="text-xs font-bold leading-none text-base-content">Jaime TL</p>
            <span class="text-[10px] text-base-content/60 font-mono">Madrid, España</span>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-base-300 bg-base-200/50 py-3 overflow-hidden">
      <div class="animate-marquee whitespace-nowrap flex gap-4">
        {[...stack, ...stack].map((tech) => (
          <span class="inline-flex items-center gap-2 font-mono text-xs px-3 py-1 rounded-lg bg-base-100 border border-base-300 text-base-content/80 font-medium shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            {tech}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14 reveal-on-scroll">
    {stats.map((s) => (
      <div class="rounded-2xl border-2 border-base-300 bg-base-200/80 p-4 text-center shadow-xs hover:border-primary/40 hover:-translate-y-1 transition-all">
        <p class="font-heading text-lg/6 sm:text-2xl font-extrabold text-primary mb-1">{s.value}</p>
        <p class="text-sm font-medium text-base-content/70">{s.label}</p>
      </div>
    ))}
  </section>

  <!-- ============================================================
        SECCIÓN DESTACADA: DEV TIPS SLIDER (1 EN 1, HASTA 5 ITEMS)
  ============================================================ -->
  {devTips.length > 0 && (
    <section class="mb-14 reveal-on-scroll">
      <div class="rounded-3xl border-2 border-primary/30 bg-linear-to-r from-base-200/90 via-base-100 to-base-200/90 p-4 sm:p-8 shadow-lg relative overflow-hidden">
        
        <!-- Cabecera del Slider -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:mb-6 border-b border-base-300/80 pb-4">
          <div class="flex items-center gap-3">
            <div class="p-2.5 rounded-xl bg-primary text-primary-content shadow-xs">
              <Icon name="mdi:lightbulb-on" class="w-6 h-6 animate-pulse" />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-primary">Dev Tip destacado</span>
                {devTipsDate && (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-base-300 text-base-content/70">
                    {new Date(devTipsDate).toLocaleDateString("es-ES")}
                  </span>
                )}
              </div>
              <h2 class="font-heading text-xl sm:text-2xl font-bold text-base-content">
                Novedades & Consejos Técnicos
              </h2>
            </div>
          </div>

          <!-- Controles del Slider -->
          <div class="flex items-center gap-2 justify-center sm:self-end sm:self-auto">
            <button
              id="prev-tip-btn"
              class="btn btn-circle btn-sm btn-outline border-base-300 hover:border-primary hover:bg-primary hover:text-primary-content transition-all"
              aria-label="Consejo anterior"
            >
              <Icon name="mdi:chevron-left" class="w-5 h-5" />
            </button>
            <button
              id="next-tip-btn"
              class="btn btn-circle btn-sm btn-outline border-base-300 hover:border-primary hover:bg-primary hover:text-primary-content transition-all"
              aria-label="Siguiente consejo"
            >
              <Icon name="mdi:chevron-right" class="w-5 h-5" />
            </button>
          </div>
        </header>

        <!-- Contenedor del Carrusel (Slides 1 a 1) -->
        <div class="relative overflow-hidden min-h-[160px]">
          <div id="tips-slider-track" class="flex transition-transform duration-500 ease-in-out">
            {devTips.map((tip) => (
              <div class="w-full shrink-0 px-1">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                  <div class="space-y-3 max-w-4xl">
                    <div class="flex items-center gap-2">
                      <span class={`text-[11px] font-mono font-bold px-2.5 py-0.5 rounded-full border ${getCategoryBadgeClass(tip.category)}`}>
                        {tip.category}
                      </span>
                      <span class="text-xs font-mono text-base-content/60">
                        vía {tip.source}
                      </span>
                    </div>

                    <h3 class="font-heading text-lg sm:text-xl font-bold text-base-content leading-snug">
                      <a href={tip.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">
                        {tip.title}
                      </a>
                    </h3>

                    <p class="text-sm text-base-content/80 leading-relaxed">
                      {tip.summary}
                    </p>
                  </div>

                  <div class="shrink-0 flex items-center md:self-center">
                    <a
                      href={tip.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-primary rounded-xl px-5 shadow-sm inline-flex items-center gap-2 text-sm w-full md:w-auto justify-center"
                    >
                      <span>Leer completo</span>
                      <Icon name="mdi:open-in-new" class="w-4 h-4" />
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Indicadores (Puntos de posición) -->
        <div id="tips-indicators" class="flex justify-center gap-2 mt-5">
          {devTips.map((_, index) => (
            <button
              class="w-2.5 h-2.5 rounded-full bg-base-300 transition-all duration-300 indicator-btn"
              data-index={index}
              aria-label={`Ir al consejo ${index + 1}`}
            ></button>
          ))}
        </div>

      </div>
    </section>
  )}


  <!-- PROYECTO DESTACADO -->
  <section class="mt-16 reveal-on-scroll">
    <div class="sm:flex sm:items-center sm:justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2.5 rounded-xl bg-primary text-primary-content shadow-xs">
          <Icon name="mdi:star-outline" class="w-6 h-6" />
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-primary">Trabajo Fin de Máster</span>
          <h2 class="font-heading text-2xl sm:text-3xl font-bold text-base-content">Proyecto Destacado</h2>
        </div>
      </div>

      <a href="/proyectos/entry/2026/angotest-plataforma-completa-de-tests-online-con-django-angular-e-ia/" 
        class="text-sm mt-2 sm:mt-0 font-bold text-primary hover:underline flex items-center gap-1">
        Ver detalles <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <article class="rounded-3xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-8 shadow-md hover:border-primary/50 transition-all">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5 relative group overflow-hidden rounded-2xl border-2 border-base-300 bg-base-100 shadow-md">
          <img
            src="/images/proyectos/projects.AnGoTest-proyecto-fin-master.webp"
            alt="AnGoTest"
            class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
        </div>

        <div class="lg:col-span-7 space-y-4">
          <h3 class="font-heading text-2xl sm:text-3xl font-bold text-base-content">
            Plataforma Completa de Tests Online con IA
          </h3>
          <p class="text-base-content/80 leading-relaxed">
            Aplicación web <strong>Full-Stack</strong> de alto rendimiento. Corrección instantánea, ranking global, dashboard interactivo y <strong>generación de evaluaciones mediante IA</strong>.
          </p>

          <ul class="space-y-2 text-base-content/80">
            <li class="flex items-start gap-2">
              <Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Seguridad:</strong> Autenticación JWT mediante cookies <code class="bg-base-100 px-1 rounded border border-base-300 font-mono">HttpOnly</code>, <code class="bg-base-100 px-1 rounded border border-base-300 font-mono">SameSite=Strict</code> y protección CORS.</span>
            </li>
            <li class="flex items-start gap-2">
              <Icon name="mdi:check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
              <span><strong>Inteligencia Artificial:</strong> Creación automática de cuestionarios estructurados mediante Llama/Mistral con límites de consumo por usuario.</span>
            </li>
          </ul>

          <div class="flex flex-wrap gap-3 pt-3">
            <a
              href="/proyectos/entry/2026/angotest-plataforma-completa-de-tests-online-con-django-angular-e-ia/"
              class="btn btn-primary btn-sm rounded-lg px-5 shadow-xs inline-flex items-center gap-2"
            >
              <Icon name="mdi:file-document-outline" class="w-4 h-4" />
              <span>Ver Proyecto</span>
            </a>
            <a
              href="https://www.youtube.com/watch?v=JOpi1MysM9g"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-sm rounded-lg bg-base-100 border-base-300 inline-flex items-center gap-2"
            >
              <Icon name="mdi:youtube" class="w-4 h-4 text-red-600" />
              <span>Demo en Vídeo</span>
            </a>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- ÚLTIMAS PUBLICACIONES Y PROYECTOS -->
  <section class="mt-16 reveal-on-scroll">
    <header class="sm:flex sm:items-center sm:justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-xl bg-base-200 border border-base-300 text-primary">
          <Icon name="mdi:blog-outline" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Últimas Publicaciones</h2>
          <p class="text-sm text-base-content/70">Artículos técnicos, guías y tutoriales</p>
        </div>
      </div>
      <a href="/blog/" class="text-sm mt-2 sm:mt-0 font-bold text-primary hover:underline flex items-center gap-1">
        Ver todos <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {last_posts.map((post: any) => (
        <HorizontalCard
          title={post.data.title}
          heroImage={post.data.heroImage}
          description={post.data.description}
          badge={post.data.badge}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          url={getPostUrl(post.id)}
          target="_self"
        />
      ))}
    </div>
  </section>
  
  <section class="mt-16 reveal-on-scroll">
    <header class="sm:flex sm:items-center sm:justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-xl bg-base-200 border border-base-300 text-primary">
          <Icon name="carbon:portfolio" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Últimos Proyectos</h2>
          <p class="text-sm text-base-content/70">Desarrollos e investigaciones recientes</p>
        </div>
      </div>
      <a href="/proyectos/" class="text-sm mt-2 sm:mt-0 font-bold text-primary hover:underline flex items-center gap-1">
        Ver todos <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {last_projects.map((project: any) => (
        <HorizontalProjectItem
          title={project.data.title}
          heroImage={project.data.heroImage}
          description={project.data.description}
          badge={project.data.badge}
          pubDate={project.data.pubDate}
          tags={project.data.tags}
          url={getProjectUrl(project.id)}
          target="_self"
        />
      ))}
    </div>
  </section>

  <!-- ÚLTIMAS TAREAS -->
  <section class="mt-16 overflow-hidden reveal-on-scroll">
    <header class="sm:flex sm:items-center sm:justify-between mb-6">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-lg bg-base-200 border border-base-300 text-primary">
          <Icon name="mdi:clipboard-list-outline" class="w-6 h-6" />
        </div>
        <div>
          <h2 class="font-heading text-2xl font-bold text-base-content">Últimas tareas</h2>
          <p class="text-sm text-base-content/70">Objetivos proyectados y completados</p>
        </div>
      </div>

      <a href="/tasks/" class="text-sm mt-2 sm:mt-0 font-bold text-primary hover:underline flex items-center gap-1">
        Ver todas <Icon name="mdi:arrow-right" class="w-4 h-4" />
      </a>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        lastTasks.map((task) => {
          const isPending = !task.endDay || new Date(task.endDay) > new Date();
          return (
            <div class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-5 shadow-sm hover:border-primary/50 transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-start gap-3 mb-2">
                  <div class={`p-1.5 rounded-lg shrink-0 mt-0.5 ${isPending ? 'bg-warning/10 text-warning border border-warning/20' : 'bg-emerald-500/10 text-emerald-600 border border-emerald-500/20'}`}>
                    <Icon name={isPending ? "mdi:clock-outline" : "mdi:check-circle-outline"} class="w-5 h-5" />
                  </div>
                  <h3 class="font-heading font-bold text-base text-base-content leading-snug">
                    {task.description}
                  </h3>
                </div>
                {task.details && (
                  <p class="text-sm text-base-content/80 leading-relaxed mb-3">
                    {task.details}
                  </p>
                )}
              </div>

              <div class="flex items-center gap-1.5 pt-3 mt-2 border-t border-base-300/80 font-mono text-xs text-base-content/60">
                <Icon name="mdi:calendar-month-outline" class="w-4 h-4 text-primary shrink-0" />
                <span>
                  {task.startDay
                    ? new Date(task.startDay).toLocaleDateString("es-ES")
                    : "Sin fecha"}
                  {task.endDay &&
                    task.endDay !== task.startDay &&
                    ` → ${new Date(task.endDay).toLocaleDateString("es-ES")}`}
                </span>
              </div>
            </div>
