---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import HorizontalProjectItem from "@components/HorizontalProjectItem.astro";
import { getCollection } from "astro:content";
import { getPostUrl } from "@lib/getPostUrl";
import { getProjectUrl } from "@lib/getProjectUrl";

const title = "Bienvenid@ a mi espacio personal";
const description = "Espacio dedicado a compartir los conocimientos adquiridos en mis estudios de desarrollo full stack y blockchain";
const image="/images/others/profile-photo.webp";

const posts = (await getCollection("blog")).sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projects = (await getCollection("projects")).sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const last_posts = posts.slice(0, 3);
const last_projects = projects.slice(0, 3);
---

<BaseLayout title={title} description={description} image={image} sideBarActiveItemID="home">
  <div class="bg-base-200 rounded-xl shadow-sm py-8 sm:py-12 px-2 sm:px-6 text-center">

    <article>
      <h1 class="sm:font-semibold font-normal mb-4">Bienvenid@ a mi espacio personal 👋</h1>
      <p class="mb-6 text-lg">
        Este espacio está dedicado a compartir los conocimientos adquiridos en mis estudios de desarrollo full stack y blockchain: proyectos que voy construyendo, artículos sobre temas de actualidad en tecnología y soluciones a problemas comunes en desarrollo web y blockchain.       
      </p>
    </article>

    <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
      <a href="proyectos" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-200 transition duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
          <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
        </svg>
        Ver proyectos
      </a>
      <a href="contacto" class="bg-white text-blue-900 font-semibold py-3 px-6 rounded-lg shadow-lg hover:bg-gray-200 transition duration-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        Contacto
      </a>
    </div>
  </div>

  <!-- Publicación destacada -->
  <article class="mt-12">
    <h2 class="w-full font-bold mb-5 mt-12">AnGoTest: entregado el proyecto final de máster</h2>
    <h3 class="mb-4">Documentación, vídeo y app en producción, ya están en manos del tribunal</h3>
    <div class="prose prose-lg">
      <p>📦 <em>Hoy, 3 de septiembre de 2026, he completado la entrega oficial de AnGoTest como proyecto final de máster.</em></p>

      <p>He subido a la plataforma de la academia toda la documentación técnica, el vídeo de presentación y el enlace a la aplicación desplegada. Ahora el tribunal revisará el material y, si todo cumple con los requisitos, me agendarán una reunión para la defensa oral.</p>

      <p>El vídeo de presentación ya está disponible:</p>
      <p><a href="https://www.youtube.com/watch?v=JOpi1MysM9g" target="_blank" rel="noopener noreferrer">▶️ Ver vídeo de presentación de AnGoTest en YouTube</a></p>

      <p><strong>AnGoTest</strong> es una plataforma completa de tests online con backend en <strong>Django + DRF</strong>, frontend en <strong>Angular</strong>, base de datos <strong>PostgreSQL</strong> y despliegue con <strong>Docker</strong>. Integra generación de tests con IA (Groq), autenticación JWT con cookies HttpOnly, paneles de administración y usuario, rankings, sistema de invitaciones y mucho más.</p>

      <p>Si quieres conocer todos los detalles técnicos, las decisiones de arquitectura, los casos de uso y las medidas de seguridad, he escrito una entrada de blog extensa donde explico el proyecto de principio a fin.</p>

      <p><a href="/proyectos/entry/2026/angotest-plataforma-completa-de-tests-online-con-django-angular-e-ia/">📖 Leer la entrada completa →</a></p>

      <p>Próximamente, actualizaré con la fecha de la defensa. ¡Mantente al tanto!</p>

      <h3 class="mt-8 mb-3">🔜 Lo que viene</h3>

      <p>Una vez superada la defensa y conseguido el título, ya tengo en mente el siguiente gran desafío: un desarrollo basado en <strong>Java</strong>. Será un proyecto pensado para profundizar en el ecosistema JVM, explorar Spring Boot, persistencia avanzada y buenas prácticas en el backend empresarial. La idea es mantener la misma exigencia que con AnGoTest: producto completo, arquitectura limpia y despliegue real.</p>

      <p>El ciclo continúa: aprender, construir, desplegar, y volver a aprender. Ahora toca esperar el veredicto del tribunal y preparar la defensa, pero la mirada ya está puesta en el siguiente salto.</p>
    </div>
  </article>

  <div class="divider mt-0 pt-8" />

  <h2 class="w-full font-bold mb-8 mt-12">Últimos posts ✍️</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-10">
    {
      last_posts.map((post: any) => (
        <HorizontalCard
          title={post.data.title}
          heroImage={post.data.heroImage}
          description={post.data.description}
          badge={post.data.badge}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          url={getPostUrl(post.id)}
          target="_self"
        />
      ))
    }
  </div>

  <h2 class="w-full font-bold mb-8 mt-10">Últimos proyectos 💻</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pb-10">
    {
      last_projects.map((project: any) => (
        <HorizontalProjectItem
          title={project.data.title}
          heroImage={project.data.heroImage}
          description={project.data.description}
          badge={project.data.badge}
          pubDate={project.data.pubDate}
          tags={project.data.tags}
          url={getProjectUrl(project.id)}
          target="_self"
        />
      ))
    }
  </div>

  <div>&nbsp;</div>

  <div class="mb-14 text-center">
    <div class="text-2xl w-full font-bold mb-5 mt-10">N.º publicaciones por Mes</div>
    <img src="https://raw.githubusercontent.com/Jaterli/fastAPI/main/grap.png" title="N.º posts por Mes" alt="N.º posts por Mes" class="grap" />    
    <div class="mt-4">Gráfica desarrollada con <a class="customlink" href="/proyectos/entry/2024/creacion-de-grafica-de-barras-con-streamlit">Streamlit</a></div>
  </div>
</BaseLayout>

