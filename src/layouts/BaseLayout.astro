---
import Footer from "@components/Footer.astro";
import SideBar from "@components/SideBar.astro";
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../types/config";
import { getCanonicalUrl } from "@lib/getCanonicalUrl";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import '../styles/global.css';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType,
  jsonLd,
  includeSidebar = true,
  noindex = false, 
  sideBarActiveItemID,
} = Astro.props;

const canonicalURL = getCanonicalUrl(Astro.url, Astro.site);

// Imagen para redes sociales: URL absoluta y, si la página no tiene, una por defecto de 1200x630
const ogImage = new URL(image ?? "/images/others/og-default.jpg", Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/others/logo-jtl.png"> 
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {/* Bloquea la indexación si la página lo solicita, pero deja que se sigan sus enlaces */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:site_name" content="Jaime TL" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD específico (Markdown) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- JSON-LD global -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://jaterli.com/about/",
      "name": "Jaime TL",
      "alternateName": "Jaterli",
      "email": "admin@jaterli.com",
      "gender": "male",
      "nationality": "Spanish",
      "url": "https://jaterli.com",
      "image": "https://jaterli.com/images/others/profile-photo.webp",
      "jobTitle": "Desarrollador Full Stack y Blockchain (Web3)",
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "IES Rey Fernando VI",
          "url": "https://www.iesreyfernandovi.es/",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Fernando de Henares",
            "addressRegion": "Madrid",
            "addressCountry": "ES"
          },
          "description": "Ciclo Formativo de Grado Superior en Administración de Sistemas Informáticos en Red"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Academia Conquer Blocks",
          "url": "https://conquerblocks.com",
          "description": "Máster en Desarrollo Full Stack"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Academia Conquer Blocks",
          "url": "https://conquerblocks.com",
          "description": "Máster en Desarrollo Blockchain"
        }
      ],
      "knowsAbout": [
        "Django",
        "React",
        "Python",
        "JavaScript",
        "TypeScript",
        "Solidity",
        "Angular",
        "Go",
        "Web3",
        "Blockchain",
        "Smart Contracts",
        "Machine Learning",
        "Artificial Intelligence",
        "Threat Intelligence",
        "Full Stack Development",
        "WordPress"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/jaterli",
        "https://github.com/Jaterli"
      ],
      "description": "Desarrollo Web Full Stack | Optimización, automatización y escalabilidad. Más de 20 años de experiencia creando soluciones web dinámicas, seguras y escalables."
    }
    </script>

    <noscript>
      <style>
        .reveal-on-scroll { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    {TRANSITION_API && <ClientRouter />}
  </head>
  <body>
    <div class="bg-base-100 min-h-screen flex flex-col">
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}

      <main
        class="mx-auto w-full px-2 py-4 sm:px-6 sm:py-8 lg:pt-8 lg:max-w-[1280px] flex-1"
        transition:animate="fade"
      >
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>