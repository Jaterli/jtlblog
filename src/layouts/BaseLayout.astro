---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from "@components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../types/config";
import '../styles/global.css';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType,
  jsonLd,
  includeSidebar = true,
  sideBarActiveItemID,  
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/others/logo-jtl.png">
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://www.jaterli.com${image}`} />
    <!-- <meta property="og:image" content={new URL(image, Astro.url)} /> -->

    <!-- JSON-LD específico (Markdown) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- JSON-LD global -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://jaterli.com/about/",
      "name": "Jaime TL",
      "alternateName": "Jaterli",
      "email": "admin@jaterli.com",
      "gender": "male",
      "nationality": "Spanish",
      "url": "https://jaterli.com",
      "image": "https://jaterli.com/images/others/profile-photo.webp",
      "jobTitle": "Desarrollador Full Stack y Blockchain (Web3)",
      "worksFor": {
        "@type": "Organization",
        "name": "Freelance"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "IES Rey Fernando VI",
          "url": "https://www.iesreyfernandovi.es/",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "San Fernando de Henares",
            "addressRegion": "Madrid",
            "addressCountry": "Spain"
          },
          "description": "Ciclo Formativo de Grado Superior en Administración de Sistemas Informáticos en Red"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Academia Conquer Blocks",
          "url": "https://conquerblocks.com",
          "description": "Máster en Desarrollo Full Stack"
        },
        {
          "@type": "EducationalOrganization",
          "name": "Academia Conquer Blocks",
          "url": "https://conquerblocks.com",
          "description": "Máster en Desarrollo Blockchain"
        }
      ],
      "knowsAbout": [
        "Django",
        "React",
        "Python",
        "JavaScript",
        "TypeScript",
        "Solidity",
        "Rust",
        "Web3",
        "Blockchain",
        "Smart Contracts",
        "Full Stack Development",
        "WordPress"
      ],
      "sameAs": [
        "https://www.linkedin.com/in/jaterli",
        "https://github.com/Jaterli"
      ],
      "description": "Desarrollador Full Stack especializado en Django, React y Web3. Más de 10 años de experiencia creando soluciones web dinámicas, seguras y escalables."
    }
    </script>

    {TRANSITION_API && <ClientRouter />}
  </head>
  <body>
    <div class="bg-base-100 drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
       
        <!-- Modo claro / modo oscuro button -->
        <ThemeToggle /> 
        <!-- Header, solo se renderiza con el menú hamburguesa -->
        <Header />
        
        <div class="mx-auto sm:p-6 sm:pt-10 p-3 lg:max-w-[1000px] max-w-[100vw]">
          <main transition:animate="slide">           
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
  </body>
</html>