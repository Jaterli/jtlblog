---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";

export type Props = CollectionEntry<"jobs">["data"];

const { title, description, startDate, endDate, heroImage, badge } = Astro.props;
const format_startDate = new Date(startDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
const format_endDate = new Date(endDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="prose prose-lg prose-img:mx-auto">
    {heroImage && (
      <div class="hero-post">
        <Image width={1400} src={heroImage} alt={title} class="w-full hover:scale-105 transition-transform duration-300" />
        {badge && (
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="badge badge-neutral rounded -rotate-6 shadow-lg font-bold text-lg sm:text-xl px-4 py-1">
              {badge}
            </div>
          </div>
        )}
        <h1 class="title">{title}</h1>
      </div>
    )}

    {format_startDate && format_endDate && (
      <>📅 <time class="italic opacity-70">{format_startDate} - {format_endDate}</time></>
    )}

    <div class="divider mt-0 mb-2"></div>
    <slot />

    <div class="text-right pt-4">
      <a href="javascript:history.back()" class="text-sm opacity-70 hover:opacity-100 transition-opacity duration-300">
        ← Regresar
      </a>
    </div>

    <div class="divider my-2"></div>
  </article>
</BaseLayout>
