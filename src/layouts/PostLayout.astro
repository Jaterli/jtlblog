---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";

export type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, heroImage, jsonLd, badge, tags = [] } = Astro.props;
const displayDate = new Date(pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article", jsonLd={jsonLd}>
  <article class="prose prose-lg prose-img:mx-auto">
    {heroImage && (
      <div class="relative w-full mb-6">
        <Image width={1400} src={heroImage} alt={title} class="w-full" />
        {badge && (
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="badge badge-neutral rounded -rotate-6 shadow-lg font-bold text-lg sm:text-xl px-4 py-1">
              {badge}
            </div>
          </div>
        )}
      </div>
    )}
    <h1 class="title">{title}</h1>

    {pubDate && <>📅 <time class="italic opacity-70">{displayDate}</time></>}

    <div class="divider mt-0 mb-2"></div>     
    <slot />
    <div class="divider my-2"></div>

  </article>

  <section>
    <div class="mt-4 flex flex-wrap gap-2">
    {
      tags &&
        tags.map((tag) => (
          <a href={`/blog/tag/${tag.toLowerCase()}`} class="badge badge-outline">
            {tag}
          </a>
        ))
    }
    </div>
  </section>

</BaseLayout>
