---
import { type ProjectSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";

export interface Props extends ProjectSchema {}

const {
  title,
  description,
  heroImage,
  jsonLd,
  badge,
  pubDate,
  tags
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("DD/MM/YYYY")
import { Image } from "astro:assets";
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article", jsonLd={jsonLd}>
  <article class="prose prose-lg prose-img:mx-auto">
    {heroImage && <Image width={750} height={422} src={heroImage} alt={title} class="w-full mb-6" />}
    <h1 class="title my-2">{title}</h1>
    
    <div class="mb-4">
    <!-- {badge && <div class="badge badge-neutral rounded mr-2">{badge}</div>} -->
    {
      tags &&
        tags.map((tag) => (
          <a href={`/proyectos/tag/${tag.toLowerCase()}`} class="badge badge-outline mr-2 no-underline hover:bg-gray-500">
            {tag}
          </a>            
        ))
    }
    </div>
    {pubDate && <time class="italic opacity-70">{displayDate}</time>}
    <div class="divider my-2"></div>
    <slot />
    <div class="divider my-2"></div>
  </article>
</BaseLayout>
