---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

export type Props = CollectionEntry<"projects">["data"];

const { title, description, heroImage, jsonLd, badge, pubDate, tags } = Astro.props;

const displayDate = pubDate
  ? new Date(pubDate).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout
  title={title}
  description={description}
  image={typeof heroImage === "string" ? heroImage : heroImage?.src}
  ogType="article"
  jsonLd={jsonLd}
>
  <!-- ============================================================
        CABECERA DEL PROYECTO (texto izq / imagen der)
  ============================================================ -->
  <section class="relative overflow-hidden rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-10 shadow-sm mb-8">
    <!-- Fondo decorativo -->
    <div
      class="absolute inset-0 opacity-20 pointer-events-none bg-[url('/images/others/hero-pattern.svg')] g-repeat bg-cover"
      aria-hidden="true"
    ></div>
    <div
      class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-primary/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-center">
      <!-- ===== Columna izquierda: texto ===== -->
      <div class="space-y-4">
        <!-- Metadatos: Badge y Fecha -->
        <div class="flex flex-wrap items-center gap-3">
          {badge && (
            <span class="px-2 py-0.5 rounded bg-primary/30 border border-primary/40 text-xs font-mono text-base-content/70 font-medium">
              {badge}
            </span>
          )}
          {displayDate && (
            <span class="flex items-center gap-1.5 text-xs sm:text-sm text-base-content/60">
              <Icon name="mdi:calendar-month-outline" class="w-4 h-4 text-primary" />
              <time>{displayDate}</time>
            </span>
          )}
        </div>

        <!-- Título principal -->
        <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.10] text-base-content">
          {title}
        </h1>

        {description && (
          <p class="text-lg text-base-content/80 leading-relaxed mb-6">
            {description}
          </p>
        )}

        <div>
          <a
            href="/proyectos/"
            class="btn btn-outline rounded-lg bg-base-100 hover:bg-base-200 border-base-300 transition-colors inline-flex items-center gap-2"
          >
            <Icon name="mdi:folder-multiple" class="w-5 h-5 text-primary" />
            Ver todos los proyectos
          </a>
        </div>

      </div>

      <!-- ===== Columna derecha: pila de imágenes (apiladas en vertical) ===== -->
      {heroImage && (
        <div class="relative flex justify-center items-center py-10 lg:py-14">
          <!-- Contenedor cuyo ancho lo marca SIEMPRE la imagen central -->
          <div class="relative w-full">

            <!-- Imagen trasera SUPERIOR (solo sobresale por arriba) -->
            <div
              class="absolute -top-8 left-1/2 -translate-x-1/2 w-[85%] -rotate-2 z-0 rounded-xl overflow-hidden border-2 border-base-300/80 bg-base-100 p-1.5 shadow-md opacity-90 grayscale contrast-125 saturate-50 blur-[1px]"
              aria-hidden="true"
            >
              <Image
                width={1280}
                src={heroImage}
                alt=""
                class="max-h-[500px] w-full rounded-lg object-cover"
              />
            </div>

            <!-- Imagen trasera INFERIOR (solo sobresale por abajo) -->
            <div
              class="absolute -bottom-8 left-1/2 -translate-x-1/2 w-[85%] rotate-2 z-0 rounded-xl overflow-hidden border-2 border-base-300/80 bg-base-100 p-1.5 shadow-md opacity-90 hue-rotate-60 saturate-150 blur-[1px]"
              aria-hidden="true"
            >
              <Image
                width={1280}
                src={heroImage}
                alt=""
                class="max-h-[500px] w-full rounded-lg object-cover"
              />
            </div>

            <!-- Imagen CENTRAL protagonista (define el ancho del bloque) -->
            <div class="relative z-10 w-full rounded-xl overflow-hidden border-2 border-primary/50 bg-base-100 p-2 shadow-2xl transition-all duration-300 hover:scale-[1.02]">
              <Image
                width={1280}
                src={heroImage}
                alt={title}
                class="max-h-[560px] w-full inline-block rounded-lg object-cover"
              />
            </div>

          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ============================================================
        CONTENIDO PRINCIPAL DEL PROYECTO
  ============================================================ -->
  <article class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-10 shadow-sm mb-8">
    <div class="prose prose-md max-w-none text-base-content/85 prose-headings:font-heading prose-headings:font-bold prose-headings:text-base-content prose-a:text-primary hover:prose-a:underline prose-strong:text-base-content prose-img:rounded-xl prose-img:border-2 prose-img:border-base-300 prose-code:font-mono prose-code:text-primary">
      <slot />
    </div>
  </article>

  <!-- ============================================================
        SECCIÓN DE ETIQUETAS
  ============================================================ -->
  {tags && tags.length > 0 && (
    <section class="rounded-2xl border-2 border-base-300 bg-base-200/90 p-4 sm:p-6 shadow-sm mb-6">
      <div class="flex flex-wrap items-center gap-2">
        <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/60 mr-2">
          <Icon name="mdi:tag-multiple-outline" class="w-4 h-4 text-primary" />
          Etiquetas:
        </div>
        {tags.map((tag: string) => (
          <a
            href={`/proyectos/tag/${tag.toLowerCase()}`}
            class="font-mono text-xs px-3 py-1.5 rounded-lg bg-base-100 border border-base-300 hover:border-primary/50 text-base-content/80 hover:text-primary transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============================================================
        BOTÓN DE REGRESO
  ============================================================ -->
  <div class="flex justify-end mt-4">
    <a
      href="javascript:history.back()"
      class="btn btn-outline btn-sm rounded-lg bg-base-100 hover:bg-base-200 border-base-300 transition-colors inline-flex items-center gap-2"
    >
      <Icon name="mdi:arrow-left" class="w-4 h-4 text-primary" />
      Regresar
    </a>
  </div>
</BaseLayout>