---
import { Image } from "astro:assets";
import dayjs from "dayjs";

const {
  title,
  description,
  heroImage,
  startDate,
  endDate,
  badge,
  details,
  url,
} = Astro.props;

const startObj = dayjs(startDate);
const endObj = dayjs(endDate);
const formatStart = startObj.format("DD/MM/YYYY");
const formatEnd = endObj.format("DD/MM/YYYY");
---

<article
  class="group flex flex-col h-full rounded-xl border border-base-300/60 bg-base-200/40 hover:bg-base-200 hover:border-primary/40 transition-all duration-200 overflow-hidden"
>
  {
    heroImage && (
      <a href={url} class="block aspect-video overflow-hidden bg-base-100/50">
        <Image
          src={heroImage}
          width={450}
          height={250}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      </a>
    )
  }

  <div class="flex flex-col grow p-4 sm:p-6">
    <!-- Metadatos: rango de fechas + badge -->
    <div class="flex items-center gap-2 mb-3 text-xs">
      <time
        datetime={startObj.toISOString()}
        class="text-base-content/50"
      >
        {formatStart}
      </time>
      <span class="text-base-content/30">→</span>
      <time
        datetime={endObj.toISOString()}
        class="text-base-content/50"
      >
        {formatEnd}
      </time>
      {badge && (
        <span class="px-2 py-0.5 rounded bg-base-100 border border-base-300/60 text-base-content/70 font-medium ml-auto">
          {badge}
        </span>
      )}
    </div>

    <!-- Título -->
    <h3 class="font-semibold text-base leading-snug mb-2">
      <a href={url} class="group-hover:text-primary transition-colors">
        {title}
      </a>
    </h3>

    <!-- Descripción -->
    <p class="text-sm text-base-content/70 leading-relaxed grow">
      {description}
    </p>

    <!-- Detalles (si existen) -->
    {
      details && (
        <p class="mt-4 pt-4 border-t border-base-300/60 text-xs text-base-content/55 leading-relaxed">
          {details}
        </p>
      )
    }
  </div>
</article>