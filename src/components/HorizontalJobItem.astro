---
import dayjs from "dayjs";

const {
  title,
  description,
  heroImage,
  startDate,
  endDate,
  badge,
  details,
  url,
} = Astro.props;
import { Image } from "astro:assets";

const format_startDate = dayjs(startDate).format("DD/MM/YYYY")
const format_endDate = dayjs(endDate).format("DD/MM/YYYY")
---

<div class="header-card flex-col transition ease-in-out h-full">
  {
    heroImage && (
      <div class="relative w-full">
        <div class="aspect-video overflow-hidden">
          <a href={url}>
            <Image
              src={heroImage}
              width={450}
              height={250}
              alt={title}
              class="w-full h-full"
            />
          </a>
        </div>
      </div>
    )
  }

  <article class="grow w-full p-4">
    <a href={url}>
      <h3>{title}</h3>   
      {badge && (
        <div class="badge badge-neutral inline align-text-top">{badge}</div>
      )}         
      <p class="py-4 opacity-90">
        <span class="mr-1">{description}</span>
        <span class="text-xs opacity-70 italic">[{format_startDate} - {format_endDate}]</span>
      </p>
      <!-- <p class="pt-2 text-sm opacity-70">{format_startDate} - {format_endDate}</p>         -->
    </a>
  </article>
</div>
