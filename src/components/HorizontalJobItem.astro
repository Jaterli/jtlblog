---
import dayjs from "dayjs";

const {
  title,
  description,
  heroImage,
  startDate,
  endDate,
  badge,
  details,
  url,
} = Astro.props;
import { Image } from "astro:assets";

const format_startDate = dayjs(startDate).format("DD/MM/YYYY")
const format_endDate = dayjs(endDate).format("DD/MM/YYYY")
---

<div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <a href={url}>
    <div class="hero-content flex-col md:flex-row">
      {
        heroImage && (
          <div class="w-full md:w-[13rem] aspect-video rounded-lg overflow-hidden">
          <Image
            src={heroImage}
            width={750}
            height={500}
            alt={title}
            class="w-full h-full object-cover"
          />
          </div>
        )
      }
      <article class="grow w-full md:p-0">
        <h3>{title}
          {badge && <div class="badge badge-neutral rounded my-2 ml-1">{badge}</div>}  
        </h3>   
        <p class="pb-2 opacity-90">
          <span class="text-1xl mr-1">{description}</span>
          <span class="text-xs opacity-70 italic">[{format_startDate} - {format_endDate}]</span>
        </p>
        <!-- <p class="pt-2 text-sm opacity-70">{format_startDate} - {format_endDate}</p>         -->
      </article>
    </div>
  </a>
</div>
