---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const { title, description, image = '/images/others/Screenshot-jtlblog.webp', ogType = 'website' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/images/others/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/images/others/logo-jtl.png">
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Jaime TL",
  "alternateName": "Jaterli",
  "url": "https://jaterli.com",
  "image": "http://jaterli.com/images/others/profile-photo.webp",
  "jobTitle": "Desarrollador Full Stack y Blochchain (Web3)",
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance"
  },
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "Máster en Desarrollo Full Stack"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Máster en Desarrollo Blockchain"
    }
  ],
  "knowsAbout": [
    "Django",
    "React",
    "Python",
    "JavaScript",
    "TypeScript",
    "Solidity",
    "Rust",
    "Web3",
    "Blockchain",
    "Smart Contracts",
    "Full Stack Development",
	"WordPress",
  ],
  "sameAs": [
    "https://www.linkedin.com/in/jaterli",
    "https://github.com/Jaterli"
  ],
  "description": "Desarrollador Full Stack especializado en Django, React y Web3. Más de 10 años de experiencia creando soluciones web dinámicas, seguras y escalables."
}
</script>
