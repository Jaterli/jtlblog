---
import { Image } from "astro:assets";
import dayjs from "dayjs";

const { title, heroImage, description, badge, pubDate, tags, url} = Astro.props;
const displayDate = dayjs(pubDate).format("DD/MM/YYYY")
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <div class="hero-content flex-col md:flex-row">
    {
      heroImage && (
        <div class="relative w-full md:w-[13rem]">
          <div class="aspect-video rounded-lg overflow-hidden">
            <a href={url}>
              <Image
                src={heroImage}
                width={750}
                height={500}
                alt={title}
                class="w-full h-full object-cover"
              />
            </a>
          </div>
          {badge && (
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="badge badge-neutral text-lg md:text-sm rounded -rotate-6">{badge}</div>
            </div>
          )}
        </div>
      )
    }
      
    <article class="grow w-full md:p-0">
      <a href={url}>

      <h3>{title}</h3>
      <p class="sm:py-1 py-3 opacity-90">
        <span class="mr-1">{description}</span>
        <span class="text-xs opacity-70 italic"> [{displayDate}]</span>
      </p>
      </a>
      <div class="flex flex-wrap gap-2">
      {
        tags &&
          tags.map((tag) => (
            <a href={`/blog/tag/${tag.toLowerCase()}`} class="badge badge-outline">
              {tag}
            </a>
          ))
      }
      </div>
    </article>
  </div>
</div>
