---
import { Icon } from "astro-icon/components";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-100"; // For primary color replace with `active` class
---
<nav>
    <ul class="menu grow shrink menu-md overflow-y-auto">
        <li><a class="py-2 text-base" id="home" href="/"><Icon name="mdi:home" /> Home</a></li>
        <li><a class="py-2 text-base" id="proyectos" href="/proyectos/"><Icon name="carbon:portfolio" /> Proyectos</a></li>
        <li><a class="py-2 text-base" id="blog" href="/blog/"><Icon name="mdi:blog-outline" /> Blog</a></li>
        <li><a class="py-2 text-base" id="servicios" href="/servicios/"><Icon name="mdi:tools" /> Servicios</a></li>
        <li><a class="py-2 text-base" id="tareas" href="/tasks/" data-astro-reload><Icon name="mdi:clipboard-list-outline" /> Tareas</a></li>    
        <li><a class="py-2 text-base" id="about" href="/about/"><Icon name="mdi:about-circle-outline" /> Sobre mi</a></li>
        <li><a class="py-2 text-base" id="cv" href="/cv/"><Icon name="academicons:cv-square" /> CV</a></li>
        <li><a class="py-2 text-base" id="contacto" href="/contacto/"><Icon name="mdi:contact-outline" /> Contacto</a></li>
    </ul>
</nav>
<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>