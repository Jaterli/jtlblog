---
const { sideBarActiveItemID } = Astro.props;

const links = [
  { id: "home",       label: "Home",       href: "/" },
  { id: "proyectos",  label: "Proyectos",  href: "/proyectos/" },
  { id: "blog",       label: "Blog",       href: "/blog/" },
  { id: "servicios",  label: "Servicios",  href: "/servicios/" },
  { id: "about",      label: "Sobre mí",   href: "/about/" },
  { id: "contacto",   label: "Contacto",   href: "/contacto/" },
];
---

<nav aria-label="Navegación principal">
  <ul class="flex items-center gap-1">
    {links.map(({ id, label, href }) => (
      <li>
        <a
          id={id}
          href={href}
          class="nav-link relative px-3 py-2 text-sm font-medium tracking-wide text-base-content/70 hover:text-base-content transition-colors duration-200"
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.35rem;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Estado activo añadido por JS */
  .nav-link.is-active {
    color: var(--fallback-bc, oklch(var(--bc)));
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
</style>

<script define:vars={{ sideBarActiveItemID }}>
  if (sideBarActiveItemID) {
    const el = document.getElementById(sideBarActiveItemID);
    if (el) el.classList.add("is-active");
  }
</script>