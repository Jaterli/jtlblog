---
import { Image } from "astro:assets";
import dayjs from "dayjs";

const {
  title,
  description,
  heroImage,
  badge,
  pubDate,
  url,
  tags
} = Astro.props;
const displayDate = dayjs(pubDate).format("DD/MM/YYYY")
const tag_url = '/blog/tag/'
---

<div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <a href={url}>
    <div class="hero-content flex-col md:flex-row">
      {
        heroImage && (
          <div class="w-full md:w-[13rem] aspect-video rounded-lg overflow-hidden">
          <Image
            src={heroImage}
            width={750}
            height={500}
            format="webp"
            alt={title}
            class="w-full h-full object-cover"
          />
          </div>
        )
      }

      <article class="grow w-full md:p-0">
        <h2 class="text-xl leading-[1.2] pb-2">{title}
          {badge && <div class="badge badge-neutral rounded my-2 ml-1">{badge}</div>}  
        </h2>
        <p class="pb-2 text-1xl leading-[1.3] opacity-90">{description}
          <span class="text-xs opacity-70 italic ml-1"> [{displayDate}]</span>          
        </p>
        <!-- <div class="text-sm opacity-70 float-left">{displayDate}</div> -->
        <div class="card-actions justify-end leading-[1.2]">
          {
            tags && tags.map((tag) => (
            <a href={`${tag_url}${tag.toLowerCase()}`}><span class="badge badge-outline opacity-70 hover:bg-gray-500">{tag}</span></a>
            ))
          }
        </div>

      </article>
    </div>
  </a>
</div>
