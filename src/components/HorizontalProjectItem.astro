---
import { Image } from "astro:assets";
import dayjs from "dayjs";

const {
  title,
  description,
  heroImage,
  badge,
  pubDate,
  url,
  tags
} = Astro.props;
const displayDate = dayjs(pubDate).format("DD/MM/YYYY")
---

<div class="header-card flex-col transition ease-in-out h-full">
  {
    heroImage && (
      <div class="relative w-full">
        <div class="aspect-video overflow-hidden">
          <a href={url}>
            <Image
              src={heroImage}
              width={450}
              height={250}
              alt={title}
              class="w-full h-full"
            />
          </a>
        </div>
      </div>
    )
  }

  {badge && (
    <div class="badge header-badge badge-neutral font-bold text-xl rounded -rotate-6">{badge}</div>
  )}
  <article class="grow w-full p-4">
    <a href={url}>
      <h3>{title}</h3>
      <p class="py-4 opacity-90">
        <span class="mr-1">{description}</span>
        <span class="text-xs opacity-70 italic"> [{displayDate}]</span>
      </p>
    </a>
    <div class="flex flex-wrap gap-2">
    {
      tags &&
        tags.map((tag) => (
          <a href={`/proyectos/tag/${tag.toLowerCase()}`} class="badge badge-outline">
            {tag}
          </a>
        ))
    }
    </div>

  </article>
</div>