---
import Button from "./ui/Button.astro";
---

<form
  method="post"
  name="contact" 
  id="contact-form"
  action="/"
  data-netlify-recaptcha="true"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="form-container"
>
  
  <input type="hidden" name="form-name" value="contact" />
  <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response" />
  <input name="bot-field" style="display:none" name="bot-field" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nombre completo"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correo electrónico</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correo electrónico"
      name="email"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    />
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Tu mensaje"
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    ></textarea>
  </div>

  <Button type="submit" size="lg" class="mt-3" block>Enviar mensaje</Button>

</form>

<div id="recaptcha-container" class="hidden"></div>

<div id="msg-error-container" class="mt-3 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">Error!</span><br />
    <span class="block sm:inline"></span>
  </div>
  <button type="button" class="absolute top-0 right-1 px-0 py-0" onclick="this.parentElement.style.display='none'" aria-label="Close">
    &times;
  </button>
</div>

<div id="msg-success-container" class="mt-3 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">¡Gracias!</span><br />
    <span class="block sm:inline">Tu mensaje ha sido enviado.</span>
  </div>
  <button type="button" class="absolute top-0 right-1 px-0 py-0" onclick="this.parentElement.style.display='none'" aria-label="Close">
    &times;
  </button>
</div>




<style>

  #recaptcha-container > div{
    width: fit-content !important;
  }
</style>


<script type="text/javascript" defer>
  document.querySelector('form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    
    // Cargar reCAPTCHA dinámicamente
    if (typeof grecaptcha === 'undefined') {
      await new Promise((resolve) => {
        const script = document.createElement('script');
        script.src = 'https://www.google.com/recaptcha/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        script.onload = resolve;
        document.head.appendChild(script);
      });
    }

    // Renderizar reCAPTCHA
    window.grecaptcha.ready(() => {
      const container = document.getElementById('recaptcha-container');
      container.classList.remove('hidden');
      
      grecaptcha.render(container, {
        sitekey: '6LdPR94qAAAAALzCZS684qB2vFUhfJK76W_GtKkd',//import.meta.env.VITE_SITE_RECAPTCHA_SECRET,
        callback: (token) => {
          document.getElementById('g-recaptcha-response').value = token;
          form.submit(); // Enviar formulario automáticamente
        },
        'expired-callback': () => {
          grecaptcha.reset();
        }
      });
    });
  });
</script>


<script src="/js/contact-form.js" defer></script>
