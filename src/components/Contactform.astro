---
import Button from "./ui/Button.astro";
// const SITE_KEY = import.meta.env.VITE_RECAPTCHA_SITE_KEY;
const SITE_KEY = '6LdUxxgrAAAAAJBH7V847nzcuLmmX_GCAP64warM';
---
<script is:inline src={`https://www.google.com/recaptcha/api.js?render=${SITE_KEY}`}></script>

<form
  method="post"
  name="contact" 
  id="contact-form"
  action="/"
  data-netlify="true"
>
  
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nombre completo"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correo electrónico</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correo electrónico"
      name="email"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    />
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Tu mensaje"
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    ></textarea>
  </div>

  <!-- <div id="recaptcha-container" class="flex justify-center w-full items-center" data-size="compact" data-netlify-recaptcha="true"></div> -->

  <Button type="submit" size="lg" class="mt-3" block>Enviar mensaje</Button>

</form>

<div id="msg-error-container" class="mt-3 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">Error!</span><br />
    <span class="block sm:inline"></span>
  </div>
  <button type="button" class="absolute top-0 right-1 px-0 py-0" onclick="this.parentElement.style.display='none'" aria-label="Close">
    &times;
  </button>
</div>

<div id="msg-success-container" class="mt-3 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">¡Gracias!</span><br />
    <span class="block sm:inline">Tu mensaje ha sido enviado.</span>
  </div>
  <button type="button" class="absolute top-0 right-1 px-0 py-0" onclick="this.parentElement.style.display='none'" aria-label="Close">
    &times;
  </button>
</div>



<!-- <script src="/js/contact-form.js" defer></script> -->

<style>

  #recaptcha-container > div{
    width: fit-content !important;
  }
</style>



<script is:inline>
  const form = document.getElementById('contact-form');
  const msgErrorContainer = document.getElementById('msg-error-container');
  const msgSuccessContainer = document.getElementById('msg-success-container');

  // Cargar reCAPTCHA correctamente
  grecaptcha.ready(() => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      try {
        // Generar token con acción específica
        const token = await grecaptcha.execute(`${SITE_KEY}`, {
          action: 'submit'
        });

        // Verificar token
        const verification = await fetch('/api/recaptcha', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token })
        });

        const result = await verification.json();
        
        if (!result.success) {
          throw new Error(`reCAPTCHA Error: ${result.errors.join(', ')}`);
        }

        // Enviar formulario a Netlify
        const formData = new FormData(form);
        const netlifyResponse = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData).toString()
        });

        if (!netlifyResponse.ok) throw new Error('Form submission failed');
        
        msgSuccessContainer.style.display = 'block';
        msgErrorContainer.style.display = 'none';
        form.reset();

      } catch (error) {
        console.error('Error:', error);
        msgErrorContainer.querySelector('span:last-child').textContent = error.message;
        msgSuccessContainer.style.display = 'none';
        msgErrorContainer.style.display = 'block';
      }
    });
  });
</script>