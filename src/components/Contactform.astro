---
export const prerender = false;

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
if (!recaptchaSiteKey) {
  throw new Error("Falta la clave RECAPTCHA_SITE_KEY en el entorno");
}
---
<form
  method="post"
  name="contact" 
  id="contact-form"
  data-netlify="true"
  data-sitekey={recaptchaSiteKey}
>
  
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <input type="hidden" name="form-name" value="contact" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nombre completo"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correo electrónico</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correo electrónico"
      name="email"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    />
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Tu mensaje"
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    ></textarea>
  </div>

  <div class="mb-3">
    <label class="flex items-start gap-3 cursor-pointer text-sm text-base-content/80">
      <input
        type="checkbox"
        name="privacy"
        value="aceptada"
        required
        class="checkbox checkbox-sm mt-0.5"
      />
      <span>
        He leído y acepto la
        <a href="/politica-de-privacidad/" target="_blank" rel="noopener noreferrer" class="text-primary underline">Política de Privacidad</a>
      </span>
    </label>
  </div>

  <details class="mb-3 text-xs text-base-content/70 leading-relaxed">
    <summary class="cursor-pointer font-semibold">Información básica sobre protección de datos</summary>
    <ul class="mt-2 space-y-1">
      <li><strong>Responsable:</strong> Jaime Terciado.</li>
      <li><strong>Finalidad:</strong> atender tu consulta o solicitud.</li>
      <li><strong>Legitimación:</strong> tu consentimiento (art. 6.1.a RGPD).</li>
      <li><strong>Destinatarios:</strong> Netlify, Inc. (alojamiento y recepción del formulario) y Google (reCAPTCHA, antispam). No se ceden datos a otros terceros salvo obligación legal.</li>
      <li><strong>Derechos:</strong> acceso, rectificación, supresión, oposición, limitación y portabilidad en admin@jaterli.com, y reclamación ante la AEPD.</li>
    </ul>
  </details>

  <button type="submit" class="btn btn-soft w-full mt-3">Enviar mensaje</button>

  <p class="mt-3 text-xs text-base-content/60">
    Este sitio está protegido por reCAPTCHA y se aplican la
    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="underline">Política de Privacidad</a> y los
    <a href="https://policies.google.com/terms" target="_blank" rel="noopener noreferrer" class="underline">Términos del Servicio</a> de Google.
  </p>
</form>

<div id="msg-error-container" class="mt-3 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">Error!</span><br />
    <span class="block sm:inline"></span>
  </div>
  <button type="button" class="alert-close absolute top-0 right-1 px-0 py-0" aria-label="Close">
    &times;
  </button>
</div>

<div id="msg-success-container" class="mt-3 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" style="display: none;" role="alert">
  <div class="flex-1">
    <span class="font-bold">¡Gracias!</span><br />
    <span class="block sm:inline">Tu mensaje ha sido enviado.</span>
  </div>
  <button type="button" class="alert-close absolute top-0 right-1 px-0 py-0" aria-label="Close">
    &times;
  </button>
</div>


<script is:inline>
  const form = document.getElementById('contact-form');
  const msgErrorContainer = document.getElementById('msg-error-container');
  const msgSuccessContainer = document.getElementById('msg-success-container');
  const errorMessageSpan = msgErrorContainer.querySelector('span:last-child');
  const siteKey = form.dataset.sitekey;

  if (!siteKey) {
    throw new Error("Falta la clave RECAPTCHA_SITE_KEY");
  }
 
  // Carga diferida de reCAPTCHA: solo tras aceptar la política o al enviar
  let recaptchaPromise = null;
  function loadRecaptcha() {
      if (recaptchaPromise) return recaptchaPromise;
      recaptchaPromise = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = `https://www.google.com/recaptcha/enterprise.js?render=${siteKey}`;
          script.async = true;
          script.onload = () => resolve();
          script.onerror = () => {
              recaptchaPromise = null; // permitir reintento
              reject(new Error('No se pudo cargar la verificación antispam'));
          };
          document.head.appendChild(script);
      });
      return recaptchaPromise;
  }

  // Precarga al marcar la casilla de privacidad (acción afirmativa del usuario)
  const privacyCheckbox = form.querySelector('input[name="privacy"]');
  privacyCheckbox.addEventListener('change', () => {
      if (privacyCheckbox.checked) loadRecaptcha().catch(() => {});
  });

  form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      try {
          // Salvaguarda: si no se precargó, se carga ahora
          await loadRecaptcha();
          await new Promise((resolve, reject) => {
              grecaptcha.enterprise.ready(async () => {
                  try {
                      const token = await grecaptcha.enterprise.execute(
                        siteKey, 
                        { action: 'contact' }
                      );
                      
                      const recaptchaResponse = await fetch('/api/recaptcha', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({ token })
                      });

                      if (!recaptchaResponse.ok) throw new Error('Error en validación reCAPTCHA');
                      
                      const result = await recaptchaResponse.json();
                      
                      if (result.success && result.score > 0.5) {
                          await submitForm(form);
                          handleSuccess();
                      } else {
                          throw new Error('Error de verificación reCAPTCHA');
                      }
                      resolve();
                  } catch (error) {
                      reject(error);
                  }
              });
          });
      } catch (error) {
          handleError(error);
      }
  });

  async function submitForm(form) {
      const formData = new FormData(form);
      const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(formData).toString()
      });
      if (!response.ok) throw new Error('Error en envío de formulario');
  }

  const handleSuccess = () => {
    console.log("Formulario enviado correctamente");
    form.style.display = 'none';
    msgSuccessContainer.style.display = 'block';
    msgErrorContainer.style.display = 'none';
    form.reset();
  };

  const handleError = (error) => {
    console.error('Error:', error);
    errorMessageSpan.textContent = error.message;
    form.style.display = 'none';
    msgSuccessContainer.style.display = 'none';
    msgErrorContainer.style.display = 'block';
  };

  // Función para restaurar la vista inicial
  const resetFormView = () => {
    form.style.display = 'block';
    msgErrorContainer.style.display = 'none';
    msgSuccessContainer.style.display = 'none';
  };  

  // Manejadores para los botones de cierre
  document.querySelectorAll('.alert-close').forEach(button => {
    button.addEventListener('click', resetFormView);
  });

</script>