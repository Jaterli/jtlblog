---
import Button from "./ui/Button.astro";

const accessKey = import.meta.env.VITE_PUBLIC_ACCESS_KEY;
const reCAPTCHA_site_key = import.meta.env.VITE_SITE_RECAPTCHA_KEY;
---

<!-- // Styling Requires Tailwind CSS -->
<form
  method="post"
  class="needs-validation"
  name="contact" 
  id="form"
  action="/"
  data-netlify-recaptcha="true"
  data-netlify="true"
>
  
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nombre completo"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correo electrónico</label><input
      id="email_address"
      type="email"
      placeholder="Correo electrónico"
      name="email"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    />
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Tu mensaje"
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    ></textarea>
  </div>

  <div data-netlify-recaptcha="true"></div>

  <Button type="submit" size="lg" block>Enviar mensaje</Button>

  <div id="result"></div>
</form>


<script is:inline>

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("form");
    const result = document.getElementById("result");

    console.log("DOM cargado")
    

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      result.innerHTML = "Enviando...";

      fetch("/", {
        method: "POST",

        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body: json,
      })
        .then(async (response) => {
          let json = await response.json();
          if (response.status == 200) {
            result.innerHTML = json.message;
          } else {
            result.innerHTML = json.message;
          }
        })
        .catch((error) => {
          result.innerHTML = "¡Algo salió mal!";
        })
        .then(function () {
          form.reset();
          setTimeout(() => {
            result.style.display = "none";
          }, 5000);
        });
    });
  }, { once: true });
</script>

<script src="https://www.google.com/recaptcha/api.js"></script>