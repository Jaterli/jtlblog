---
import Button from "./ui/Button.astro";
---

<form
  method="post"
  class="needs-validation"
  name="contact" 
  id="contact-form"
  action="/"
  data-netlify-recaptcha="true"
  data-netlify="true"
>
  
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  <div class="mb-5">
    <input
      type="text"
      placeholder="Nombre completo"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
      name="name"
    />
  </div>
  <div class="mb-5">
    <label for="email_address" class="sr-only">Correo electrónico</label>
    <input
      id="email_address"
      type="email"
      placeholder="Correo electrónico"
      name="email"
      required
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    />
  </div>
  <div class="mb-3">
    <textarea
      name="message"
      required
      placeholder="Tu mensaje"
      class="w-full px-4 py-3 border placeholder:text-slate-400 rounded-md outline-none h-36 focus:ring-4 border-slate-300 focus:border-slate-600 ring-slate-100"
    ></textarea>
  </div>

  <div id="recaptcha-container" class="mb-3 flex justify-center items-center" data-netlify-recaptcha="true"></div>

  <Button type="submit" size="lg" block>Enviar mensaje</Button>

</form>

<div id="contact-form-result" class="flex items-center justify-center min-h-[100px]"></div>

<script src="/js/contact-form.js" defer></script>


<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
  <div class="flex-1">
    <strong class="font-bold">Error!</strong><br />
    <span class="block sm:inline"> Por favor, completa el reCAPTCHA.</span>
  </div>
  <button type="button" class="absolute top-0 right-1 px-0 py-0" onclick="this.parentElement.style.display='none'" aria-label="Close">
    &times;
  </button>
</div>