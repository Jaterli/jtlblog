{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "types": ["astro/client"],
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@scripts/*": ["./public/scripts/*"],
      "@lib/*": ["./src/lib/*"],
    }
  },
  "include": ["src/**/*", "public/js"]
}