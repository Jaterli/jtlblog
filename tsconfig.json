{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "types": ["astro/client"],
    "typeRoots": ["./node_modules/@types", "./src/types"],    
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@layouts/*": [
        "src/layouts/*"
      ],
      "@scripts/*": [
        "public/scripts/*"
      ]           
    }
  },
  "include": ["src/**/*"]  
}